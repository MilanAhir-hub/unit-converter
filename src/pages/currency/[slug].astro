      h1: `فهم سعر صرف ${from} مقابل ${to}`,
      h2: 'ما الذي يسبب تقلبات أسعار الصرف؟',
      h3: 'السياق التاريخي والأداء'
    },
    'ja': {
      h1: `${from}から${to}への為替レートを理解する`,
      h2: '外国為替の変動要因とは？',
      h3: '歴史的背景 & パフォーマンス'
    }
  };
  return templates[loc] || templates['en'];
};
const headings = getLocalizedSectionHeadings(locale);

// Define related currency conversions
const relatedConversions = [
  { href: `/currency/${to.toLowerCase()}-to-${from.toLowerCase()}`, label: `${to} to ${from} (Reverse)` },
  { href: `/currency/usd-to-eur`, label: `USD to EUR` },
  { href: `/currency/usd-to-inr`, label: `USD to INR` },
  { href: `/currency/eur-to-usd`, label: `EUR to USD` },
  { href: `/currency/gbp-to-inr`, label: `GBP to INR` }
].filter(item => !item.href.includes(`${from.toLowerCase()}-to-${to.toLowerCase()}`));

const localizedRelatedConversions = relatedConversions.map(item => ({
  href: getLocalizedHref(item.href),
  label: item.label.includes('Reverse') ? `${to} to ${from} (${t('reverse', locale) || 'Reverse'})` : item.label
}));

const lastUpdated = new Date(latestDate).toLocaleDateString(locale === 'en' ? 'en-US' : locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
});
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    "url": canonicalUrl,
    "name": pageTitle,
    "description": pageDescription
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FinancialProduct",
    "name": `${from} to ${to} Exchange Rate Conversion`,
    "description": `Exchange rate specifications for converting ${fromName} (${from}) to ${toName} (${to}).`,
    "offers": {
      "@type": "Offer",
      "price": currentValue.toFixed(4),
      "priceCurrency": to
    }
  })} />

  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href={getLocalizedHref("/")} class="hover:text-ink transition-colors">{t('nav_home', locale)}</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <a href={getLocalizedHref("/unit-converters/currency")} class="hover:text-ink transition-colors">{translateCategory('currency', locale)}</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{from} to {to}</span>
    </nav>

    <!-- Header Title -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">
        {fromName} to {toName}
      </h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">
        {curStrings.headerDesc}
      </p>
    </header>

    <!-- Mid-market Instant Rate box -->
    <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden mb-8 sm:mb-10">
      <div class="p-6 sm:p-10 md:p-12 text-center border-b border-hairline bg-canvas-soft-2 flex flex-col items-center">
        <div class="text-[11px] font-mono text-mute uppercase tracking-widest mb-3">{curStrings.liveExchangeRate}</div>
        
        <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 mb-4">
          <div class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-ink break-all">
            1 {from} = <span class="text-primary" id="live-rate-val" data-from={from} data-to={to}>{currentValue.toFixed(4)}</span> {to}
          </div>
          <div class={`px-2.5 py-1 rounded-full text-xs font-bold ${change.isUp ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-red-500/10 text-red-600 dark:text-red-400'}`}>
            {change.formatted}
          </div>
        </div>

        <p class="text-xs sm:text-sm text-mute max-w-lg leading-relaxed">
          {curStrings.midMarketDesc}
        </p>
      </div>

      <!-- Real-Time Interactive Calculator Widget -->
      <div class="p-6 sm:p-10 bg-canvas grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 border-b border-hairline">
        <div class="space-y-4">
          <h2 class="text-base font-semibold text-ink flex items-center gap-2">
            <Icon name="hugeicons:calculate" class="w-5 h-5 text-primary" />
            {curStrings.quickCalculator}
          </h2>
          
          <div class="space-y-3">
            <div class="space-y-1">
              <label class="text-[10px] font-mono text-mute uppercase tracking-wider">{curStrings.amount} ({from})</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-mute font-mono text-sm">{fromSymbol}</span>
                <input
                  id="calc-from-input"
                  type="number"
                  value="1"
                  step="any"
                  class="w-full h-11 pl-9 pr-4 bg-canvas-soft border border-hairline rounded-sm text-base font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] font-mono text-mute uppercase tracking-wider">{curStrings.convertedResult} ({to})</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-mute font-mono text-sm">{toSymbol}</span>
                <input
                  id="calc-to-input"
                  type="number"
                  readonly
                  value={currentValue.toFixed(4)}
                  class="w-full h-11 pl-9 pr-4 bg-canvas-soft-2 border border-hairline rounded-sm text-base font-bold text-primary focus:outline-none cursor-default"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- 7-Day Mini Chart -->
        <div class="space-y-4">
          <h2 class="text-base font-semibold text-ink flex items-center gap-2">
            <Icon name="hugeicons:chart-line-data-01" class="w-5 h-5 text-primary" />
            {curStrings.sevenDayTrajectory}
          </h2>
          
          <div class="h-24 bg-canvas-soft border border-hairline rounded-sm p-3 relative overflow-hidden flex items-center justify-center">
            <div class="absolute inset-x-0 top-1/2 border-t border-hairline/30 pointer-events-none"></div>
            <svg class="w-full h-full overflow-visible" viewBox="0 0 120 40" preserveAspectRatio="none">
              <path
                d={sparkline}
                fill="none"
                stroke={change.isUp ? "#10b981" : "#ef4444"}
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono text-mute">
            <span>{curStrings.sevenDaysAgo}</span>
            <span>{curStrings.today}</span>
          </div>
        </div>
      </div>

      <!-- Freshness footer -->
      <div class="px-6 py-3 bg-canvas-soft-2 flex items-center justify-between text-xs text-mute font-sans">
        <div class="flex items-center gap-1.5">
          <Icon name="hugeicons:clock-01" class="w-3.5 h-3.5" />
          <span>{curStrings.ratesLastUpdated} <strong class="text-ink" id="last-updated-time">{lastUpdated}</strong></span>
        </div>
        <a href={getLocalizedHref("/unit-converters/currency")} class="text-primary hover:underline font-semibold flex items-center gap-1">
          {curStrings.fullDashboard}
          <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Educational Description Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Main Content Block -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- Explanation article -->
        <section class="bg-canvas border border-hairline rounded-md p-6 sm:p-8 space-y-5">
          <h2 class="text-xl font-semibold text-ink">{headings.h1}</h2>
          <p class="text-sm text-body leading-relaxed" set:html={paragraphs.p1} />

          <h3 class="text-base font-semibold text-ink pt-3 border-t border-hairline">{headings.h2}</h3>
          <p class="text-sm text-body leading-relaxed" set:html={paragraphs.p2} />
          <ul class="list-disc pl-5 text-sm text-body leading-relaxed space-y-2">
            <li set:html={paragraphs.li1} />
            <li set:html={paragraphs.li2} />
            <li set:html={paragraphs.li3} />
            <li set:html={paragraphs.li4} />
          </ul>

          <h3 class="text-base font-semibold text-ink pt-3 border-t border-hairline">{headings.h3}</h3>
          <p class="text-sm text-body leading-relaxed" set:html={paragraphs.p3} />
        </section>

        <!-- FAQs -->
        <section class="bg-canvas border border-hairline rounded-md p-6 sm:p-8 space-y-6">
          <h2 class="text-xl font-semibold text-ink">{curStrings.faqTitle}</h2>
          <div class="space-y-6 divide-y divide-hairline">
            {localizedFaqList.map((item, idx) => (
              <div class={idx > 0 ? "pt-6" : ""}>
                <h4 class="text-base font-semibold text-ink mb-2">{item.q}</h4>
                <p class="text-sm text-body leading-relaxed" set:html={item.a} />
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Right Sidebar -->
      <aside class="space-y-6">
        
        <!-- Related conversions list -->
        <div class="bg-canvas border border-hairline rounded-md p-6 space-y-4">
          <h3 class="text-base font-semibold text-ink">{curStrings.relatedConversions}</h3>
          <ul class="space-y-2.5 text-xs">
            {localizedRelatedConversions.map(link => (
              <li>
                <a href={link.href} class="text-link hover:underline flex items-center gap-1.5 font-medium">
                  <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 shrink-0 text-mute" />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Full converter category backlink -->
        <div class="p-5 bg-primary/5 border border-primary/15 rounded-md">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-2">{curStrings.fullCurrencyTool}</h3>
          <p class="text-xs text-ink/70 leading-relaxed mb-3">
            {curStrings.fullCurrencyToolDesc}
          </p>
          <a
            href={getLocalizedHref("/unit-converters/currency")}
            class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline"
          >
            {curStrings.openCurrencyDashboard}
            <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 font-bold" />
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script define:vars={{ currentValue }}>
  const fromInput = document.getElementById('calc-from-input');
  const toInput = document.getElementById('calc-to-input');

  let currentRate = currentValue;

  // Real-time calculation logic
  function performCalculation() {
    const rawVal = fromInput.value.trim();
    if (rawVal === '' || isNaN(parseFloat(rawVal))) {
      toInput.value = '';
      return;
    }
    const val = parseFloat(rawVal);
    toInput.value = (val * currentRate).toFixed(4);
  }

  if (fromInput && toInput) {
    fromInput.addEventListener('input', performCalculation);
  }

  // Load fresh rate dynamically if available
  const rateValEl = document.getElementById('live-rate-val');
  if (rateValEl) {
    const fromCur = rateValEl.getAttribute('data-from');
    const toCur = rateValEl.getAttribute('data-to');

    // Attempt to read from shared localStorage cache (populated by main widget)
    try {
      const cacheKey = 'realunitconverter_rates_cache';
      const cacheStr = localStorage.getItem(cacheKey);
      if (cacheStr) {
        const cache = JSON.parse(cacheStr);
        // Cache valid for 1 hour
        if (Date.now() - cache.timestamp < 3600000 && cache.rates) {
          const rates = cache.rates;
          const fromRate = rates[fromCur.toUpperCase()];
          const toRate = rates[toCur.toUpperCase()];
          if (fromRate && toRate) {
            currentRate = toRate / fromRate;
            rateValEl.textContent = currentRate.toFixed(4);
            performCalculation();
          }
        }
      }
    } catch (_) {}

    // Async live fetch in the background to ensure absolute rate freshness
    fetch(`https://api.frankfurter.app/latest?from=${fromCur}`)
      .then(res => {
        if (!res.ok) throw new Error();
        return res.json();
      })
      .then(data => {
        if (data && data.rates && data.rates[toCur.toUpperCase()]) {
          currentRate = data.rates[toCur.toUpperCase()];
          rateValEl.textContent = currentRate.toFixed(4);
          
          const updatedDate = new Date(data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: 'numeric',
            minute: 'numeric',
            timeZone: 'UTC',
            timeZoneName: 'short'
          });
          
          const timeEl = document.getElementById('last-updated-time');
          if (timeEl) timeEl.textContent = updatedDate;
          
          performCalculation();
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type=number] { -moz-appearance: textfield; }
</style>
