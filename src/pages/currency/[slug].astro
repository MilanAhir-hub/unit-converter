---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import {
  fetchHistoricalRates,
  calculateCrossRateSeries,
  calculate24hChange,
  generateSparkline
} from '../../utils/currencyApi';

export async function getStaticPaths() {
  const currencies = ['USD', 'EUR', 'GBP', 'JPY', 'INR', 'CAD', 'AUD', 'CHF', 'CNY'];
  const paths = [];

  // Fetch once at build time
  const historicalRates = await fetchHistoricalRates();
  const sortedDates = Object.keys(historicalRates).sort();
  const latestDate = sortedDates[sortedDates.length - 1] || new Date().toISOString().split('T')[0];

  for (const from of currencies) {
    for (const to of currencies) {
      if (from === to) continue;
      
      const slug = `${from.toLowerCase()}-to-${to.toLowerCase()}`;
      const rateSeries = calculateCrossRateSeries(historicalRates, from, to);
      const change = calculate24hChange(rateSeries);
      const sparkline = generateSparkline(rateSeries);
      const currentValue = rateSeries[rateSeries.length - 1];

      paths.push({
        params: { slug },
        props: {
          from,
          to,
          rateSeries,
          change,
          sparkline,
          currentValue,
          latestDate
        }
      });
    }
  }

  return paths;
}

const { slug } = Astro.params;
let {
  from,
  to,
  rateSeries,
  change,
  sparkline,
  currentValue,
  latestDate
} = Astro.props;

if (!from || !to) {
  if (slug) {
    const match = slug.match(/^([a-z]{3})-to-([a-z]{3})$/i);
    if (match) {
      from = match[1].toUpperCase();
      to = match[2].toUpperCase();
      
      const currencies = ['USD', 'EUR', 'GBP', 'JPY', 'INR', 'CAD', 'AUD', 'CHF', 'CNY'];
      if (!currencies.includes(from) || !currencies.includes(to)) {
        return Astro.redirect('/404');
      }

      try {
        const historicalRates = await fetchHistoricalRates();
        const sortedDates = Object.keys(historicalRates).sort();
        latestDate = sortedDates[sortedDates.length - 1] || new Date().toISOString().split('T')[0];
        rateSeries = calculateCrossRateSeries(historicalRates, from, to);
        change = calculate24hChange(rateSeries);
        sparkline = generateSparkline(rateSeries);
        currentValue = rateSeries[rateSeries.length - 1];
      } catch (err) {
        console.error('SSR Currency calculation failed:', err);
        return Astro.redirect('/404');
      }
    } else {
      return Astro.redirect('/404');
    }
  } else {
    return Astro.redirect('/404');
  }
}

if (!from || !to || !rateSeries || currentValue === undefined) {
  return Astro.redirect('/404');
}

