      }
    ],
    'pt': [
      {
        q: `Como usar o ${tVal}?`,
        a: `Insira seu valor no campo "Desde" e selecione sua unidade inicial. Em seguida, escolha sua unidade de destino. O resultado é calculado instantaneamente — sem necessidade de clicar em um botão.`
      },
      {
        q: `O ${tVal} é preciso?`,
        a: `Sim. Usamos fatores de conversão padrão da indústria derivados dos padrões SI e NIST para garantir a máxima precisão em todas as conversões.`
      },
      {
        q: `Posso inverter a direção da conversão?`,
        a: `Absolutamente — clique no botão de troca (⇄) no centro para inverter instantaneamente a direção da conversão.`
      },
      {
        q: `O conversor funciona offline?`,
        a: `Sim. Toda a lógica de conversão é executada inteiramente no seu navegador. Nenhuma solicitação de rede é feita quando você digita um valor ou altera uma unidade.`
      }
    ],
    'de': [
      {
        q: `Wie verwende ich den ${tVal}?`,
        a: `Geben Sie Ihren Wert in das Feld „Von“ ein und wählen Sie Ihre Ausgangseinheit. Wählen Sie dann Ihre Zieleinheit. Das Ergebnis wird sofort berechnet – es ist kein Klick auf eine Schaltfläche erforderlich.`
      },
      {
        q: `Ist der ${tVal} genau?`,
        a: `Ja. Wir verwenden branchenübliche Umrechnungsfaktoren, die von SI- und NIST-Standards abgeleitet sind, um maximale Präzision bei allen Umrechnungen zu gewährleisten.`
      },
      {
        q: `Kann ich die Umrechnungsrichtung tauschen?`,
        a: `Absolut – klicken Sie auf die Tauschschaltfläche (⇄) in der Mitte, um die Umrechnungsrichtung sofort umzukehren.`
      },
      {
        q: `Funktioniert der Umrechner offline?`,
        a: `Ja. Die gesamte Umrechnungslogik läuft vollständig in Ihrem Browser. Es wird keine Netzwerkanfrage gestellt, wenn Sie einen Wert eingeben oder eine Einheit ändern.`
      }
    ],
    'ar': [
      {
        q: `كيف يمكنني استخدام محول ${tVal}؟`,
        a: `أدخل قيمتك في حقل "من" وحدد وحدة البداية الخاصة بك. ثم اختر الوحدة المستهدفة. يتم حساب النتيجة على الفور - لا حاجة للنقر على أي زر.`
      },
      {
        q: `هل محول ${tVal} دقيق؟`,
        a: `نعم. نحن نستخدم عوامل تحويل قياسية في الصناعة مستمدة من معايير SI و NIST لضمان أقصى قدر من الدقة لجميع عمليات التحويل.`
      },
      {
        q: `هل يمكنني تبديل اتجاه التحويل؟`,
        a: `بالتأكيد - انقر فوق زر التبديل (⇄) في المنتصف لعكس اتجاه التحويل على الفور.`
      },
      {
        q: `هل يعمل المحول بدون اتصال بالإنترنت؟`,
        a: `نعم. تعمل جميع عمليات التحويل بالكامل في متصفحك. لا يتم إجراء أي طلب شبكة عند كتابة قيمة أو تغيير وحدة.`
      }
    ],
    'ja': [
      {
        q: `${tVal}の使い方は？`,
        a: `「から」フィールドに数値を入力し、開始単位を選択します。次に、対象の単位を選択します。結果は即座に計算されます（ボタンをクリックする必要はありません）。`
      },
      {
        q: `${tVal}は正確ですか？`,
        a: `はい。すべての変換において最大の精度を保証するため、SIおよびNIST規格に準拠した業界標準 of 変換係数を使用しています。`
      },
      {
        q: `変換方向を入れ替えることはできますか？`,
        a: `はい、中央の入れ替えボタン（⇄）をクリックすると、変換方向が即座に逆になります。`
      },
      {
        q: `変換ツールはオフラインで動作しますか？`,
        a: `はい。すべての変換ロジックはブラウザ上で完全に実行されます。値の入力や単位の変更時にネットワーク要求は行われません。`
      }
    ]
  };
  return templates[loc] || templates['en'];
};
const faq = getLocalizedFaq(localizedTitle, locale);

const getLocalizedHowToUse = (tVal: string, loc: string) => {
  const templates: Record<string, string[]> = {
    'en': [
      `Enter any numerical value in the <strong class="text-ink">From</strong> field on the left. The result appears instantly in the <strong class="text-ink">To</strong> field — no button click required.`,
      `Use the dropdowns to change the source or target unit at any time. Tap the <strong class="text-ink">⇄ swap button</strong> to quickly reverse the conversion direction.`,
      `Press <strong class="text-ink">Copy</strong> to copy the full result statement to your clipboard, ready to paste anywhere.`
    ],
    'es': [
      `Ingrese cualquier valor numérico en el campo <strong class="text-ink">Desde</strong> a la izquierda. El resultado aparece instantáneamente en el campo <strong class="text-ink">Hacia</strong>, sin necesidad de hacer clic en ningún botón.`,
      `Utilice los menús desplegables para cambiar la unidad de origen o de destino en cualquier momento. Toque el <strong class="text-ink">botón de intercambio ⇄</strong> para invertir rápidamente la dirección de conversión.`,
      `Presione <strong class="text-ink">Copiar</strong> para copiar la declaración de resultado completa en su portapapeles, lista para pegar en cualquier lugar.`
    ],
    'hi': [
      `बाईं ओर <strong class="text-ink">से</strong> फ़ील्ड में कोई भी संख्यात्मक मान दर्ज करें। परिणाम तुरंत <strong class="text-ink">तक</strong> फ़ील्ड में दिखाई देता है — किसी बटन पर क्लिक करने की आवश्यकता नहीं है।`,
      `किसी भी समय स्रोत या लक्ष्य इकाई को बदलने के लिए ड्रॉपडाउन का उपयोग करें। रूपांतरण की दिशा को तुरंत बदलने के लिए <strong class="text-ink">⇄ स्वैप बटन</strong> को टैप करें।`,
      `अपने क्लिपबोर्ड पर पूर्ण परिणाम विवरण कॉपी करने के लिए <strong class="text-ink">कॉपी</strong> दबाएं, जिसे कहीं भी पेस्ट किया जा सकता है।`
    ],
    'fr': [
      `Saisissez n'importe quelle valeur numérique dans le champ <strong class="text-ink">De</strong> à gauche. Le résultat apparaît instantanément dans le champ <strong class="text-ink">À</strong> — aucun clic de bouton n'est requis.`,
      `Utilisez les listes déroulantes pour modifier l'unité source ou cible à tout moment. Appuyez sur le <strong class="text-ink">bouton d'échange ⇄</strong> pour inverser rapidement le sens de la conversion.`,
      `Appuyez sur <strong class="text-ink">Copier</strong> pour copier la déclaration de résultat complète dans votre presse-papiers, prête à être collée n'importe où.`
    ],
    'pt': [
      `Insira qualquer valor numérico no campo <strong class="text-ink">Desde</strong> à esquerda. O resultado aparece instantaneamente no campo <strong class="text-ink">Para</strong> — nenhum clique de botão é necessário.`,
      `Use os menus suspensos para alterar a unidade de origem ou destino a qualquer momento. Toque no <strong class="text-ink">botão de troca ⇄</strong> para reverter rapidamente a direção da conversão.`,
      `Pressione <strong class="text-ink">Copiar</strong> para copiar la declaração de resultado completa para a área de transferência, pronta para colar em qualquer lugar.`
    ],
    'de': [
      `Geben Sie einen beliebigen numerischen Wert in das linke Feld <strong class="text-ink">Von</strong> ein. Das Ergebnis erscheint sofort im Feld <strong class="text-ink">Nach</strong> – kein Klick auf eine Schaltfläche erforderlich.`,
      `Verwenden Sie die Dropdown-Listen, um die Ausgangs- oder Zieleinheit jederzeit zu ändern. Tippen Sie auf die <strong class="text-ink">⇄ Tauschschaltfläche</strong>, um die Umrechnungsrichtung schnell umzukehren.`,
      `Drücken Sie auf <strong class="text-ink">Kopieren</strong>, um das vollständige Ergebnis in Ihre Zwischenablage zu kopieren, sodass Sie es überall einfügen können.`
    ],
    'ar': [
      `أدخل أي قيمة عددية في حقل <strong class="text-ink">من</strong> على اليسار. تظهر النتيجة على الفور في حقل <strong class="text-ink">إلى</strong> - لا يلزم النقر فوق أي زر.`,
      `استخدم القوائم المنسدلة لتغيير وحدة المصدر أو الوحدة المستهدفة في أي وقت. اضغط على <strong class="text-ink">زر التبديل ⇄</strong> لعكس اتجاه التحويل بسرعة.`,
      `اضغط على <strong class="text-ink">نسخ</strong> لنسخ بيان النتيجة الكامل إلى الحافظة الخاصة بك، لتكون جاهزة للصقها في أي مكان.`
    ],
    'ja': [
      `左側の<strong class="text-ink">から</strong>フィールドに任意の数値を入力します。結果は即座に<strong class="text-ink">まで</strong>フィールドに表示されます（ボタンをクリックする必要はありません）。`,
      `ドロップダウンを使用して、いつでも変換元または変換先の単位を変更できます。<strong class="text-ink">⇄入れ替えボタン</strong>をタップして、変換方向をすばやく逆にします。`,
      `<strong class="text-ink">コピー</strong>を押すと、結果のステートメント全体がクリップボードにコピーされ、どこにでも貼り付けられるようになります。`
    ]
  };
  return templates[loc] || templates['en'];
};
const howToUseParagraphs = getLocalizedHowToUse(localizedTitle, locale);

const getLocalizedProTip = (loc: string) => {
  const templates: Record<string, string> = {
    'en': 'You can type decimal values (e.g. <code class="font-mono bg-primary/10 px-1 py-0.5 rounded text-primary">2.54</code>) or very large numbers. The converter handles any numeric input automatically.',
    'es': 'Puede ingresar valores decimales (por ejemplo, <code class="font-mono bg-primary/10 px-1 py-0.5 rounded text-primary">2.54</code>) o números muy grandes. El conversor maneja cualquier entrada numérica automáticamente.',
