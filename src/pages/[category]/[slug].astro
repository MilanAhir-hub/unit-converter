      <a href={getLocalizedHref("/")} class="hover:text-ink transition-colors">{t('nav_home', locale)}</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{localizedCategoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{localizedTitle}</span>
    </nav>

    <!-- ── Page Header ─────────────────────────────────────────────────────── -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{localizedTitle}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{localizedDescription}</p>
    </header>

    <!-- ── Converter Card ──────────────────────────────────────────────────── -->
