<!-- ─────────────────────────────────────────────────────────────────────────── -->
<!-- Client-side Conversion Engine (Vanilla JS — no framework dependency)       -->
<!-- ─────────────────────────────────────────────────────────────────────────── -->
<script define:vars={{ unitsJson, categoryJson, defaultFrom, defaultTo, initialResult, historicalRatesJson, btnCopyText, btnCopiedText, btnSaveFavoriteText, btnSavedText, siDescriptionText, formulaMultiplyTemplate }}>

// ── Parse server-side data ────────────────────────────────────────────────────
const UNITS    = JSON.parse(unitsJson);
const CATEGORY = JSON.parse(categoryJson);
const HISTORICAL_RATES = JSON.parse(historicalRatesJson);

// ── Favorites localStorage helpers (inline to bypass load-timing delay) ────────
const FAVORITES_STORAGE_KEY = 'realunitconverter_favorites';

function getFavorites() {
  try {
    const raw = localStorage.getItem(FAVORITES_STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) {
    return [];
  }
}

function saveFavorites(items) {
  try {
    localStorage.setItem(FAVORITES_STORAGE_KEY, JSON.stringify(items));
  } catch (e) {}
}

function isFavoriteMeasurement(converterType, inputValue, fromUnit, outputValue, toUnit) {
  const items = getFavorites();
  return items.some(item => 
    item.converterType.toLowerCase() === converterType.toLowerCase() &&
    item.inputValue.trim() === inputValue.trim() &&
    item.fromUnit.toLowerCase() === fromUnit.toLowerCase() &&
    item.outputValue.trim() === outputValue.trim() &&
    item.toUnit.toLowerCase() === toUnit.toLowerCase()
  );
}

function toggleFavoriteMeasurement(item) {
  const items = getFavorites();
  const existingIndex = items.findIndex(fav => 
    fav.converterType.toLowerCase() === item.converterType.toLowerCase() &&
    fav.inputValue.trim() === item.inputValue.trim() &&
    fav.fromUnit.toLowerCase() === item.fromUnit.toLowerCase() &&
    fav.outputValue.trim() === item.outputValue.trim() &&
    fav.toUnit.toLowerCase() === item.toUnit.toLowerCase()
  );

  if (existingIndex !== -1) {
    items.splice(existingIndex, 1);
    saveFavorites(items);
    return false;
  } else {
    const newItem = {
      ...item,
      id: `fav_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
      timestamp: Date.now()
    };
    items.unshift(newItem);
    saveFavorites(items);
    return true;
  }
}

// ── DOM refs ─────────────────────────────────────────────────────────────────
const fromInput    = document.getElementById('from-input');
const toInput      = document.getElementById('to-input');
const fromDropdown = document.getElementById('from-dropdown');
const toDropdown   = document.getElementById('to-dropdown');
const swapBtn      = document.getElementById('swap-btn');
const copyBtn      = document.getElementById('copy-btn');
const copyLabel    = document.getElementById('copy-label');
const resultSummary  = document.getElementById('result-summary');
const formulaDisplay = document.getElementById('formula-display');
const favoriteBtn = document.getElementById('favorite-btn');
const favoriteIconContainer = document.getElementById('favorite-icon-container');
const favoriteLabel = document.getElementById('favorite-label');
const copyLinkBtn  = document.getElementById('copy-link-btn');
const shareBtn     = document.getElementById('share-btn');
const tweetBtn     = document.getElementById('tweet-btn');

// Fallback Share Modal refs
const shareModal = document.getElementById('share-modal');
const closeShareBtn = document.getElementById('close-share-btn');
const modalCopyLinkBtn = document.getElementById('modal-copy-link-btn');
const modalWhatsappBtn = document.getElementById('modal-whatsapp-btn');
const modalTwitterBtn = document.getElementById('modal-twitter-btn');
const modalFacebookBtn = document.getElementById('modal-facebook-btn');
const modalTelegramBtn = document.getElementById('modal-telegram-btn');
const modalLinkedinBtn = document.getElementById('modal-linkedin-btn');
const modalEmailBtn    = document.getElementById('modal-email-btn');

function getDropdownValue(dropdown) {
  return dropdown.getAttribute('data-value') || '';
}

function setDropdownValue(dropdown, value) {
  const item = dropdown.querySelector(`.dropdown-item[data-key="${value}"]`);
  if (item) {
    item.click();
  }
}

// ── Build unit index ──────────────────────────────────────────────────────────
const unitMap = {};
UNITS.forEach(u => { unitMap[u.key] = u; });

// ── Conversion logic (mirrors TypeScript engine) ──────────────────────────────

function isBinaryCategory() {
  return CATEGORY.isBinary === true;
}

function toBase(unit, value) {
  return value * (unit.factor ?? 1);
}

function fromBase(unit, baseValue) {
  return baseValue / (unit.factor ?? 1);
}

// Temperature custom logic (non-linear)
function convertTemp(value, fromKey, toKey) {
  if (fromKey === 'kelvin' && value < 0) return 'Temperature below absolute zero.';
  if (fromKey === 'celsius' && value < -273.15) return 'Temperature below absolute zero.';
  if (fromKey === 'fahrenheit' && value < -459.67) return 'Temperature below absolute zero.';
  if (fromKey === 'rankine' && value < 0) return 'Temperature below absolute zero.';
  if (fromKey === 'reaumur' && value < -218.52) return 'Temperature below absolute zero.';

  let celsius;
  switch (fromKey) {
    case 'celsius':     celsius = value; break;
    case 'fahrenheit':  celsius = (value - 32) * 5 / 9; break;
    case 'kelvin':      celsius = value - 273.15; break;
    case 'rankine':     celsius = (value - 491.67) * 5 / 9; break;
    case 'reaumur':     celsius = value * 5 / 4; break;
    default:            celsius = value;
  }
  
  switch (toKey) {
    case 'celsius':     return celsius;
    case 'fahrenheit':  return (celsius * 9 / 5) + 32;
    case 'kelvin':      return celsius + 273.15;
    case 'rankine':     return (celsius + 273.15) * 9 / 5;
    case 'reaumur':     return celsius * 4 / 5;
    default:            return celsius;
  }
}

// Fuel consumption
function convertFuel(value, fromKey, toKey) {
  let base;
  switch (fromKey) {
    case 'l-per-100km':  base = value; break;
    case 'km-per-l':     base = 100 / value; break;
    case 'mpg-us':       base = 235.215 / value; break;
    case 'mpg-uk':       base = 282.481 / value; break;
    case 'miles-per-l':  base = 100 / (value * 1.60934); break;
    default:             base = value;
  }
  switch (toKey) {
    case 'l-per-100km':  return base;
    case 'km-per-l':     return 100 / base;
    case 'mpg-us':       return 235.215 / base;
    case 'mpg-uk':       return 282.481 / base;
    case 'miles-per-l':  return 100 / (base * 1.60934);
    default:             return base;
  }
}

// Binary / number-base
function convertBinary(valueStr, fromKey, toKey) {
  let decimal;
  switch (fromKey) {
    case 'binary':      decimal = parseInt(valueStr, 2); break;
    case 'octal':       decimal = parseInt(valueStr, 8); break;
    case 'hexadecimal': decimal = parseInt(valueStr, 16); break;
    default:            decimal = parseInt(valueStr, 10); break;
  }
  if (isNaN(decimal)) return 'Invalid input';
  switch (toKey) {
    case 'binary':      return decimal.toString(2);
    case 'octal':       return decimal.toString(8);
    case 'hexadecimal': return decimal.toString(16).toUpperCase();
    default:            return decimal.toString(10);
  }
}

function doConvert(value, fromKey, toKey) {
  if (fromKey === toKey) return value;
  if (CATEGORY.slug === 'temperature')      return convertTemp(value, fromKey, toKey);
  if (CATEGORY.slug === 'fuel-consumption') return convertFuel(value, fromKey, toKey);

  const from = unitMap[fromKey];
  const to   = unitMap[toKey];
  if (!from || !to) return NaN;

  const base = value * (from.factor ?? 1);
  return base / (to.factor ?? 1);
}

function formatResult(value) {
  if (typeof value === 'string') return value;
  if (isNaN(value) || !isFinite(value)) return '—';
  if (value === 0) return '0';
  const abs = Math.abs(value);
  if (abs !== 0 && (abs >= 1e15 || abs < 1e-6)) {
    return value.toExponential(4);
  }
  return parseFloat(value.toFixed(8)).toString();
}

// ── History Tracking Engine ──────────────────────────────────────────────────
let historyDebounceTimer;
let userInteracted = false;

function scheduleHistorySave(inputValue, outputValue, fromUnitName, toUnitName) {
  if (!userInteracted) return; // Prevent saving the default conversion on page load
  
  clearTimeout(historyDebounceTimer);
  
  if (!inputValue || inputValue === '-' || outputValue === '—' || outputValue === 'Invalid') {
    return;
  }
  
  historyDebounceTimer = setTimeout(() => {
    try {
      const historyKey = 'realunitconverter_history';
      const raw = localStorage.getItem(historyKey);
      const items = raw ? JSON.parse(raw) : [];

      const cleanType = (CATEGORY.label || CATEGORY.slug)
        .replace(" Converter", "")
        .replace(" & Mass", "")
        .trim();

      const lastItem = items[0];
      if (
        lastItem &&
        lastItem.converterType === cleanType &&
        lastItem.fromUnit === fromUnitName &&
        lastItem.toUnit === toUnitName &&
        lastItem.inputValue === inputValue &&
        lastItem.outputValue === outputValue
      ) {
        lastItem.timestamp = Date.now();
        localStorage.setItem(historyKey, JSON.stringify(items));
        return;
      }

      const newItem = {
        id: Math.random().toString(36).substring(2, 9) + Date.now().toString(36).substring(4),
        timestamp: Date.now(),
        converterType: cleanType,
        fromUnit: fromUnitName,
        toUnit: toUnitName,
        inputValue: inputValue,
        outputValue: outputValue
      };

      items.unshift(newItem);
      if (items.length > 500) {
        items.pop();
      }
      localStorage.setItem(historyKey, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('history-updated'));
    } catch (e) {
      console.error('Error saving history record:', e);
    }
  }, 1000);
}

// ── Main update function ──────────────────────────────────────────────────────
function updateConversion() {
  const rawValue  = fromInput.value.trim();
  const fromKey   = getDropdownValue(fromDropdown);
  const toKey     = getDropdownValue(toDropdown);
  const fromUnit  = unitMap[fromKey];
  const toUnit    = unitMap[toKey];

  if (rawValue === '' || rawValue === '-') {
    toInput.value = '';
    resultSummary.textContent = '—';
    return;
  }

  let result;
  let displayResult;

  if (CATEGORY.slug === 'binary') {
    displayResult = convertBinary(rawValue, fromKey, toKey);
    result = displayResult;
  } else {
    const numeric = parseFloat(rawValue);
    if (isNaN(numeric)) {
      toInput.value = 'Invalid';
      return;
    }
    const converted = doConvert(numeric, fromKey, toKey);
    displayResult   = formatResult(converted);
    result = converted;
  }

  toInput.value = displayResult;

  // Result summary
  const fromLabel = fromUnit?.symbol || fromUnit?.label || fromKey;
  const toLabel   = toUnit?.symbol   || toUnit?.label   || toKey;
  resultSummary.textContent = `${rawValue} ${fromLabel} = ${displayResult} ${toLabel}`;

  // Formula hint
  if (fromUnit?.factor && toUnit?.factor && CATEGORY.slug !== 'temperature' && CATEGORY.slug !== 'fuel-consumption') {
    const factor = fromUnit.factor / toUnit.factor;
    const formatted = parseFloat(factor.toFixed(8)).toString();
    formulaDisplay.textContent = formulaMultiplyTemplate.replace('{factor}', formatted);
  } else {
    formulaDisplay.textContent = siDescriptionText;
  }

  // Auto save conversion to history
  const fromName = fromUnit?.label || fromKey;
  const toName = toUnit?.label || toKey;
  scheduleHistorySave(rawValue, displayResult, fromName, toName);

  if (typeof updateFavoriteButtonState === 'function') {
    updateFavoriteButtonState();
  }

  if (CATEGORY.slug === 'currency' && typeof updateCurrencyDashboard === 'function') {
    updateCurrencyDashboard(fromKey, toKey);
  }
}

// ── Favorites Logic ─────────────────────────────────────────────────────────
function updateFavoriteButtonState() {
  if (!favoriteBtn) return;
  const rawValue = fromInput.value.trim();
  const fromKey = getDropdownValue(fromDropdown);
  const toKey = getDropdownValue(toDropdown);
  const fromUnit = unitMap[fromKey];
  const toUnit = unitMap[toKey];

  if (rawValue === '' || rawValue === '-' || toInput.value === '' || toInput.value === 'Invalid' || toInput.value === '—') {
    favoriteBtn.style.opacity = '0.5';
    favoriteBtn.style.pointerEvents = 'none';
    return;
  }

  favoriteBtn.style.opacity = '1';
  favoriteBtn.style.pointerEvents = 'auto';

  const fromName = fromUnit?.label || fromKey;
  const toName = toUnit?.label || toKey;
  const displayResult = toInput.value;

  const saved = isFavoriteMeasurement(
    CATEGORY.label.replace(" Converter", "").replace(" & Mass", "").trim(),
    rawValue,
    fromName,
    displayResult,
    toName
  );

  if (saved) {
    favoriteIconContainer.innerHTML = `
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-amber-500 transition-transform duration-200">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    `;
    favoriteLabel.textContent = btnSavedText;
  } else {
    favoriteIconContainer.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    `;
    favoriteLabel.textContent = btnSaveFavoriteText;
  }
}

// ── Event listeners ───────────────────────────────────────────────────────────
fromInput.addEventListener('input',  () => { userInteracted = true; updateConversion(); });
fromDropdown.addEventListener('change', () => { userInteracted = true; updateConversion(); });
toDropdown.addEventListener('change',  () => { userInteracted = true; updateConversion(); });

swapBtn.addEventListener('click', () => {
  userInteracted = true;
  // Swap dropdown values
  const fromKey = getDropdownValue(fromDropdown);
  const toKey = getDropdownValue(toDropdown);
  
  setDropdownValue(fromDropdown, toKey);
  setDropdownValue(toDropdown, fromKey);

  // Animate swap button
  swapBtn.style.transform = 'rotate(180deg)';
  setTimeout(() => { swapBtn.style.transform = ''; }, 300);

  updateConversion();
});

copyBtn.addEventListener('click', () => {
  const text = resultSummary.textContent || toInput.value;
  navigator.clipboard.writeText(text).then(() => {
    copyLabel.textContent = btnCopiedText;
    setTimeout(() => { copyLabel.textContent = btnCopyText; }, 2000);
  }).catch(() => {
    // Fallback for older browsers
    const ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    copyLabel.textContent = btnCopiedText;
    setTimeout(() => { copyLabel.textContent = btnCopyText; }, 2000);
  });
});

if (favoriteBtn) {
  favoriteBtn.addEventListener('click', () => {
    const rawValue = fromInput.value.trim();
    const fromKey = getDropdownValue(fromDropdown);
    const toKey = getDropdownValue(toDropdown);
    const fromUnit = unitMap[fromKey];
    const toUnit = unitMap[toKey];

    if (rawValue === '' || rawValue === '-' || toInput.value === '' || toInput.value === 'Invalid' || toInput.value === '—') {
      return;
    }

    const fromName = fromUnit?.label || fromKey;
    const toName = toUnit?.label || toKey;
    const displayResult = toInput.value;

    toggleFavoriteMeasurement({
      converterType: CATEGORY.label.replace(" Converter", "").replace(" & Mass", "").trim(),
      inputValue: rawValue,
      fromUnit: fromName,
      outputValue: displayResult,
      toUnit: toName
    });

    const starSvg = favoriteIconContainer.querySelector('svg');
    if (starSvg) {
      starSvg.classList.add('scale-125');
      setTimeout(() => { starSvg.classList.remove('scale-125'); }, 200);
    }

    updateFavoriteButtonState();
  });
}

// Toast helper function
function showToast(message) {
  const existing = document.getElementById('share-toast');
  if (existing) {
    existing.remove();
  }
  const toast = document.createElement('div');
  toast.id = 'share-toast';
  toast.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-neutral-900 dark:bg-neutral-100 text-white dark:text-black text-xs sm:text-sm font-medium py-3 px-6 rounded-md shadow-lg border border-hairline transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2 pointer-events-none';
  toast.innerHTML = `
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-500 shrink-0">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span>${message}</span>
  `;
  document.body.appendChild(toast);
  requestAnimationFrame(() => {
    toast.classList.remove('translate-y-2', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
  });
  setTimeout(() => {
    toast.classList.remove('translate-y-0', 'opacity-100');
    toast.classList.add('translate-y-2', 'opacity-0');
    setTimeout(() => {
      if (toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }, 300);
  }, 2500);
}

// Dynamic helper to resolve device type for analytics
function getDeviceType() {
  const ua = navigator.userAgent;
  if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) {
    return 'tablet';
  }
  if (/Mobile|iP(hone|od)|Android|BlackBerry|IEMobile|Kindle|Silk-Accelerated|(hpwOS)/i.test(ua)) {
    return 'mobile';
  }
  return 'desktop';
}

