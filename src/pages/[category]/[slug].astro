      }
    ],
    'hi': [
      {
        q: `मैं ${tVal} का उपयोग कैसे करूँ?`,
        a: `अपने मान को "से" फ़ील्ड में दर्ज करें और अपनी प्रारंभिक इकाई का चयन करें। फिर अपनी लक्षित इकाई चुनें। परिणाम तुरंत गणना किया जाता है — किसी बटन पर क्लिक करने की आवश्यकता नहीं है।`
      },
