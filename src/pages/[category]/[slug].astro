<Layout title={`${localizedTitle} — Free Online ${localizedCategoryTitle}`} description={localizedDescription}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- ── Breadcrumbs ──────────────────────────────────────────────────────── -->
