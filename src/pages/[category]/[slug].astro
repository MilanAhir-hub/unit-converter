// Helper to look up unit key from label or symbol (case-insensitive)
function findUnitKey(labelOrSymbol) {
  if (!labelOrSymbol) return null;
  let clean = labelOrSymbol.toLowerCase().trim();
  
  // Common plural mapping
  if (clean === 'feet') clean = 'foot';
  if (clean.endsWith('s') && !UNITS.some(u => u.key.toLowerCase() === clean || (u.symbol && u.symbol.toLowerCase() === clean))) {
    // Try stripping 's' or 'es'
    if (clean.endsWith('es')) {
      const stripped = clean.slice(0, -2);
      if (UNITS.some(u => u.key.toLowerCase() === stripped || u.label.toLowerCase() === stripped)) {
        clean = stripped;
      }
    } else {
      const stripped = clean.slice(0, -1);
      if (UNITS.some(u => u.key.toLowerCase() === stripped || u.label.toLowerCase() === stripped)) {
        clean = stripped;
      }
    }
  }

  // First search exact key, label, or symbol
  let found = UNITS.find(u => 
    u.key.toLowerCase() === clean || 
    u.label.toLowerCase() === clean || 
    (u.symbol && u.symbol.toLowerCase() === clean)
  );

  // If not found, try substring matching
  if (!found) {
    found = UNITS.find(u => 
      u.key.toLowerCase().includes(clean) || 
      u.label.toLowerCase().includes(clean)
    );
  }
  
  return found ? found.key : null;
}

// ── Prefill values from URL query parameters ───────────────────────────
try {
  const params = new URLSearchParams(window.location.search);
  const valParam = params.get('value') || params.get('val');
  const fromParam = params.get('from');
  const toParam = params.get('to');

  let appliedFrom = null;
  let appliedTo = null;
  let appliedVal = null;

  if (fromParam && fromParam.trim()) {
    const fromKey = findUnitKey(fromParam);
    if (fromKey) {
      setDropdownValue(fromDropdown, fromKey);
      appliedFrom = fromKey;
    }
  }
  if (toParam && toParam.trim()) {
    const toKey = findUnitKey(toParam);
    if (toKey) {
      setDropdownValue(toDropdown, toKey);
      appliedTo = toKey;
    }
  }
  if (valParam && valParam.trim()) {
    const cleanVal = valParam.trim();
    if (CATEGORY.slug === 'binary') {
      const activeFrom = appliedFrom || getDropdownValue(fromDropdown);
      let isValid = true;
      if (activeFrom === 'binary' && !/^[0-1]+$/.test(cleanVal)) isValid = false;
      else if (activeFrom === 'octal' && !/^[0-7]+$/.test(cleanVal)) isValid = false;
      else if (activeFrom === 'hexadecimal' && !/^[0-9a-fA-F]+$/.test(cleanVal)) isValid = false;
      else if (activeFrom === 'decimal' && isNaN(parseFloat(cleanVal))) isValid = false;

      if (isValid) {
        fromInput.value = cleanVal;
        appliedVal = cleanVal;
      }
    } else {
      const numeric = parseFloat(cleanVal);
      if (!isNaN(numeric) && isFinite(numeric)) {
        fromInput.value = cleanVal;
        appliedVal = cleanVal;
      }
    }
  }

  // Track event
  if (appliedFrom || appliedTo || appliedVal !== null) {
    if (typeof gtag === 'function') {
      gtag('event', 'share_link_opened', {
        converter_category: CATEGORY.slug,
        source_unit: appliedFrom || getDropdownValue(fromDropdown),
        destination_unit: appliedTo || getDropdownValue(toDropdown),
        value: appliedVal !== null ? String(appliedVal) : fromInput.value,
        device_type: getDeviceType()
      });
    }
  }
} catch (e) {
  // Graceful fallback - no console errors or crashes
}

// ── Real-Time Currency Live rates sync ────────────────────────────────
const LIVE_RATES = {};

if (CATEGORY.slug === 'currency') {
  // Click handler for Popular Pairs Table rows
  const popularRows = document.querySelectorAll('.popular-pair-row');
  popularRows.forEach(row => {
    row.addEventListener('click', () => {
      const from = row.getAttribute('data-from');
      const to = row.getAttribute('data-to');
      if (from && to) {
        setDropdownValue(fromDropdown, from);
        setDropdownValue(toDropdown, to);
        updateConversion();

        if (typeof gtag === 'function') {
          gtag('event', 'popular_pair_clicked', {
            from_currency: from,
            to_currency: to,
            device_type: getDeviceType()
          });
        }
      }
    });
  });

  // Sync cache or fetch live rates
  const cachedData = loadCachedRates();
  if (cachedData && cachedData.rates) {
    console.log("Loaded cached live currency rates:", cachedData.rates);
    applyLiveRates(cachedData.rates);
    updateLastUpdatedDisplay(cachedData.date || new Date().toISOString());
    updatePopularPairsTable();
    updateConversion();
  } else {
    // Fetch live rates
    fetch('https://api.frankfurter.app/latest?from=USD')
      .then(res => {
        if (!res.ok) throw new Error(`Frankfurter API returned status ${res.status}`);
        return res.json();
      })
      .then(data => {
        if (data && data.rates) {
          const rates = { USD: 1.0, ...data.rates };
          console.log("Fetched live currency rates from API:", rates);
          saveRatesToCache(rates, data.date);
          applyLiveRates(rates);
          updateLastUpdatedDisplay(data.date);
          updatePopularPairsTable();
          updateConversion();
        } else {
          throw new Error("Invalid rate payload from API");
        }
      })
      .catch(err => {
        console.error("Failed to fetch live currency rates:", err);
        const displayEl = document.getElementById('last-updated-display');
        if (displayEl) {
          displayEl.textContent = 'Error: Stale or offline rates. Please check connection.';
          displayEl.style.color = '#ef4444';
        }
      });
  }
}

function loadCachedRates() {
  try {
    const cached = localStorage.getItem('realunitconverter_rates_cache');
    if (cached) {
      const data = JSON.parse(cached);
      if (Date.now() - data.timestamp < 3600000) { // 1 hour
        return data;
      }
    }
  } catch (_) {}
  return null;
}

function saveRatesToCache(rates, date) {
  try {
    localStorage.setItem('realunitconverter_rates_cache', JSON.stringify({
      timestamp: Date.now(),
      date: date,
      rates: rates
    }));
  } catch (_) {}
}

function applyLiveRates(rates) {
  Object.keys(rates).forEach(k => {
    LIVE_RATES[k] = rates[k];
    const uk = k.toLowerCase();
    if (unitMap[uk]) {
      unitMap[uk].factor = 1 / rates[k];
    }
  });
}

function updateLastUpdatedDisplay(dateStr) {
  const displayEl = document.getElementById('last-updated-display');
  if (displayEl) {
    const d = new Date(dateStr);
    displayEl.textContent = d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: 'numeric',
      minute: 'numeric',
      timeZone: 'UTC',
      timeZoneName: 'short'
    });
  }
}

function updatePopularPairsTable() {
  const rows = document.querySelectorAll('.popular-pair-row');
  rows.forEach(row => {
    const from = row.getAttribute('data-from').toUpperCase();
    const to = row.getAttribute('data-to').toUpperCase();
    if (from && to && LIVE_RATES[from] && LIVE_RATES[to]) {
      const cell = row.querySelector('.rate-value');
      const crossRate = LIVE_RATES[to] / LIVE_RATES[from];
      if (cell) cell.textContent = crossRate.toFixed(4);

      const changeCell = row.lastElementChild;
      if (changeCell) {
        const sortedDates = Object.keys(HISTORICAL_RATES).sort();
        const series = [];
        sortedDates.forEach(date => {
          const dateRates = HISTORICAL_RATES[date];
          const fromUsd = dateRates[from] ?? 1.0;
          const toUsd = dateRates[to] ?? 1.0;
          series.push(toUsd / fromUsd);
        });
        if (series.length > 0) {
          series[series.length - 1] = crossRate;
        }
        if (series.length >= 2) {
          const previous = series[series.length - 2];
          if (previous !== 0) {
            const percent = ((crossRate - previous) / previous) * 100;
            const isUp = percent >= 0;
            changeCell.textContent = `${isUp ? '↑ +' : '↓ '}${percent.toFixed(2)}%`;
            changeCell.className = `px-4 py-3 text-right font-bold ${isUp ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;
          }
        }
      }
    }
  });
}

function updateCurrencyDashboard(fromKey, toKey) {
  const activeTitle = document.getElementById('active-pair-title-display');
  const activeValue = document.getElementById('active-pair-value-display');
  const activeChange = document.getElementById('active-pair-change-display');
  const sparklinePath = document.getElementById('active-sparkline-path');

  if (!activeTitle || !activeValue || !activeChange || !sparklinePath) return;

  const from = fromKey.toUpperCase();
  const to = toKey.toUpperCase();

  activeTitle.textContent = `${from} to ${to} exchange rate`;

  const sortedDates = Object.keys(HISTORICAL_RATES).sort();
  const series = [];
  sortedDates.forEach(date => {
    const dateRates = HISTORICAL_RATES[date];
    const fromUsd = dateRates[from] ?? 1.0;
    const toUsd = dateRates[to] ?? 1.0;
    series.push(toUsd / fromUsd);
  });

  if (series.length > 0 && LIVE_RATES[from] && LIVE_RATES[to]) {
    series[series.length - 1] = LIVE_RATES[to] / LIVE_RATES[from];
  }

  if (series.length < 2) return;

  const currentVal = series[series.length - 1];
  activeValue.textContent = `1 ${from} = ${currentVal.toFixed(4)} ${to}`;

  const previous = series[series.length - 2];
  if (previous !== 0) {
    const diff = currentVal - previous;
    const percent = (diff / previous) * 100;
    const isUp = percent >= 0;
    const formatted = `${isUp ? '↑ +' : '↓ '}${percent.toFixed(2)}%`;

    activeChange.textContent = formatted;
    if (isUp) {
      activeChange.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
    } else {
      activeChange.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400';
    }
  }

  const pathData = generateSparklinePath(series);
  sparklinePath.setAttribute('d', pathData);
  
  const isUp = currentVal >= previous;
  sparklinePath.setAttribute('stroke', isUp ? '#10b981' : '#ef4444');
}

function generateSparklinePath(rates) {
  const width = 120;
  const height = 40;
  const padding = 4;

  const min = Math.min(...rates);
  const max = Math.max(...rates);
  const range = max - min;

  let path = '';
  for (let i = 0; i < rates.length; i++) {
    const x = (i / (rates.length - 1)) * width;
    let y = height / 2;

    if (range > 0) {
      y = height - padding - ((rates[i] - min) / range) * (height - 2 * padding);
    }

    path += `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return path;
}

// Run once on load
updateConversion();
</script>

