---
import Layout from '../../layouts/Layout.astro';
import { navigationData, isCategory } from '../../data/navigation';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';
import LearnSection from '../../components/learn/LearnSection.astro';
import CurrencyDashboard from '../../components/CurrencyDashboard.astro';
import { fetchHistoricalRates } from '../../utils/currencyApi';
import {
  converterCategories,
  getCategoryBySlug,
  buildReferenceTable,
  formatResult,
  convert,
} from '../../utils/converter';

export async function getStaticPaths() {
  const paths: any[] = [];

  // Build paths from navigation data
  navigationData.forEach((item) => {
    if (isCategory(item)) {
      item.items.forEach((subItem) => {
        const segments = subItem.href.split('/').filter(Boolean);
        if (segments.length === 2) {
          paths.push({
            params: { category: segments[0], slug: segments[1] },
            props: { title: subItem.title, categoryTitle: item.title, slug: segments[1] }
          });
        }
      });
    }
  });

  return paths;
}

let { title, categoryTitle, slug: propSlug } = Astro.props;
const { slug: paramSlug } = Astro.params;
const slug = propSlug || paramSlug || '';

// Fallback lookup from navigationData if rendering dynamically under SSR (props are empty)
if (!title || !categoryTitle) {
  for (const item of navigationData) {
    if (isCategory(item)) {
      const foundSubItem = item.items.find(sub => {
        const segs = sub.href.split('/').filter(Boolean);
        return segs[segs.length - 1] === slug;
      });
      if (foundSubItem) {
        title = foundSubItem.title;
        categoryTitle = item.title;
        break;
      }
    }
  }
}

if (!title || !categoryTitle) {
  return Astro.redirect('/404');
}

import { t, translateCategory, translateUnit, translatePopularRoute } from '../../utils/i18n';
const locale = Astro.currentLocale || 'en';

const localizedCategoryTitle = categoryTitle === 'Unit Converters' ? t('nav_converters', locale) : (categoryTitle === 'Popular Conversions' ? t('nav_popular', locale) : categoryTitle);

const localizedTitle = slug.includes('-to-') 
  ? translatePopularRoute(slug, locale, title) 
  : translateCategory(slug, locale);

const getLocalizedDescription = (tVal: string, loc: string) => {
  const templates: Record<string, string> = {
    'en': `Free, fast, and accurate ${tVal}. Convert between various units instantly.`,
    'es': `${tVal} gratis, rápido y preciso. Convierta entre varias unidades al instante.`,
    'hi': `मुफ़्त, तेज़ और सटीक ${tVal}। विभिन्न इकाइयों के बीच तुरंत रूपांतरण करें।`,
    'fr': `${tVal} gratuit, rapide et précis. Convertissez instantanément entre différentes unités.`,
    'pt': `${tVal} gratuito, rápido e preciso. Converta entre várias unidades instantaneamente.`,
    'de': `Kostenloser, schneller und genauer ${tVal}. Rechnen Sie Einheiten sofort um.`,
    'ar': `محول ${tVal} مجاني وسريع ودقيق. قم بالتحويل بين الوحدات المختلفة على الفور.`,
    'ja': `無料、迅速、正確な${tVal}。さまざまな単位を瞬時に変換します。`
  };
  return templates[loc] || templates['en'];
};
const localizedDescription = getLocalizedDescription(localizedTitle, locale);

// Look up this converter in our engine
const converterDef = getCategoryBySlug(slug);

// Fallback units when converter is not yet defined in engine
const fallbackUnits = [
  { key: 'unit-a', label: 'Unit A', symbol: 'A', factor: 1 },
  { key: 'unit-b', label: 'Unit B', symbol: 'B', factor: 1 },
];

let units = converterDef?.units ?? fallbackUnits;

if (slug === 'currency') {
  try {
    const res = await fetch('https://api.frankfurter.app/latest?from=USD');
    if (!res.ok) {
      throw new Error(`Frankfurter API returned status ${res.status}`);
    }
    const data = await res.json();
    if (data && data.rates) {
      const rates = { USD: 1.0, ...data.rates };
      units = units.map(u => {
        const rate = rates[u.key.toUpperCase()];
        if (rate) {
          return {
            ...u,
            factor: 1 / rate
          };
        }
        return u;
      });
      if (converterDef) {
        converterDef.units = units;
      }
    }
  } catch (e) {
    console.error('Failed to fetch build-time currency rates, falling back to offline rates:', e);
    // Use fallback rates to prevent build crash
    const rates: Record<string, number> = {
      USD: 1.0, EUR: 0.92, INR: 83.5, GBP: 0.78, JPY: 157.0, AUD: 1.50, CAD: 1.37, CHF: 0.89, CNY: 7.25, NZD: 1.63,
      SEK: 10.5, NOK: 10.6, MXN: 18.2, SGD: 1.35, HKD: 7.8, KRW: 1380.0, TRY: 32.5, RUB: 89.0, BRL: 5.4, ZAR: 18.0
    };
    units = units.map(u => {
      const rate = rates[u.key.toUpperCase()];
      if (rate) {
        return {
          ...u,
          factor: 1 / rate
        };
      }
      return u;
    });
    if (converterDef) {
      converterDef.units = units;
    }
  }
}

const localizedUnits = units.map(u => ({
  ...u,
  label: translateUnit(u.key, locale, u.label)
}));

const popularUnitMapping: Record<string, { from: string; to: string }> = {
  'inches-to-cm': { from: 'inch', to: 'centimeter' },
  'cm-to-inches': { from: 'centimeter', to: 'inch' },
  'feet-to-cm': { from: 'foot', to: 'centimeter' },
  'cm-to-feet': { from: 'centimeter', to: 'foot' },
  'km-to-miles': { from: 'kilometer', to: 'mile' },
  'miles-to-km': { from: 'mile', to: 'kilometer' },
  'kg-to-pounds': { from: 'kilogram', to: 'pound' },
  'pounds-to-kg': { from: 'pound', to: 'kilogram' },
  'celsius-to-fahrenheit': { from: 'celsius', to: 'fahrenheit' },
  'fahrenheit-to-celsius': { from: 'fahrenheit', to: 'celsius' },
  'liters-to-gallons': { from: 'liter', to: 'gallon-us' },
  'gallons-to-liters': { from: 'gallon-us', to: 'liter' },
  'mb-to-gb': { from: 'megabyte', to: 'gigabyte' },
  'gb-to-tb': { from: 'gigabyte', to: 'terabyte' },
  'binary-to-decimal': { from: 'binary', to: 'decimal' },
  'decimal-to-binary': { from: 'decimal', to: 'binary' }
};

const mapping = popularUnitMapping[slug];
const defaultFrom  = mapping ? mapping.from : (converterDef?.defaultFrom ?? units[0].key);
const defaultTo    = mapping ? mapping.to   : (converterDef?.defaultTo   ?? (units[1]?.key ?? units[0].key));
const description  = localizedDescription;

// Build reference table at build time for the default unit pair
const refTable = converterDef
  ? buildReferenceTable(defaultFrom, defaultTo, converterDef)
  : [];

// Initial result for the default display (input = 1)
let initialResult = '—';
if (converterDef) {
  try {
    initialResult = formatResult(convert(1, defaultFrom, defaultTo, converterDef));
  } catch (_) {}
}

const fromUnit = localizedUnits.find(u => u.key === defaultFrom);
const toUnit   = localizedUnits.find(u => u.key === defaultTo);

const getLocalizedFaq = (tVal: string, loc: string) => {
  const templates: Record<string, Array<{ q: string; a: string }>> = {
    'en': [
      {
        q: `How do I use the ${tVal}?`,
        a: `Enter your value in the "From" field and select your starting unit. Then choose your target unit. The result is calculated instantly — no button click needed.`
      },
      {
        q: `Is the ${tVal} accurate?`,
        a: `Yes. We use industry-standard conversion factors derived from SI and NIST standards to ensure maximum precision for all conversions.`
      },
      {
        q: `Can I swap the conversion direction?`,
        a: `Absolutely — click the swap button (⇄) in the centre to instantly reverse the conversion direction.`
