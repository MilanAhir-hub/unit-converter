  };
  return templates[loc] || templates['en'];
};
const localizedProTip = getLocalizedProTip(locale);

const getLocalizedRefTableTitle = (tVal: string, loc: string) => {
  const templates: Record<string, string> = {
    'en': `${tVal} Reference Table`,
    'es': `Tabla de referencia de ${tVal}`,
    'hi': `${tVal} संदर्भ तालिका`,
    'fr': `Tableau de référence de ${tVal}`,
    'pt': `Tabela de referência de ${tVal}`,
    'de': `${tVal}-Referenztabelle`,
    'ar': `جدول مرجعي لـ ${tVal}`,
    'ja': `${tVal}基準表`
  };
  return templates[loc] || templates['en'];
};
const localizedRefTableTitle = getLocalizedRefTableTitle(localizedTitle, locale);

const getLocalizedHref = (url: string) => {
  if (locale === 'en') return url;
  if (url.startsWith(`/${locale}`)) return url;
  return `/${locale}${url}`;
};

const getLocalizedPopularLinkLabel = (pLabel: string, pHref: string) => {
  const parts = pHref.split('/');
  const slugVal = parts[parts.length - 1]; // e.g. 1-inch-to-cm
  const match = slugVal.match(/^(\d+)-(.*)$/);
  if (match) {
    const val = match[1];
    const routeSlug = match[2];
    return `${val} ${translatePopularRoute(routeSlug, locale, pLabel)}`;
  }
  return pLabel;
};

// Serialize unit definitions to JSON for client-side JS
const unitsJson   = JSON.stringify(localizedUnits);
