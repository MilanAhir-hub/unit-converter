          value: rawValue,
          device_type: getDeviceType()
        });
        gtag('event', 'share_link_generated', {
          converter_category: CATEGORY.slug,
          source_unit: fromKey,
          destination_unit: toKey,
          value: rawValue,
          device_type: getDeviceType()
        });
      }

      // Prepare share data
      const shareData = {
        title: 'Real Unit Converter',
        text: `Check out this conversion: ${conversionText}`,
        url: shareUrl
      };

      // Validate URL is absolute and valid
      try {
        const validatedUrl = new URL(shareUrl);
        if (!validatedUrl.protocol.startsWith('http')) {
          throw new Error('Invalid protocol');
        }
      } catch (err) {
        openShareModal(shareUrl, conversionText);
        return;
      }

      // Feature detection for Web Share API
      if (navigator.share) {
        // If canShare is available, use it for pre-flight validation
        if (navigator.canShare && !navigator.canShare(shareData)) {
          openShareModal(shareUrl, conversionText);
          return;
        }

        navigator.share(shareData)
          .then(() => {
            // Track successful share
            if (typeof gtag === 'function') {
              gtag('event', 'share_success', {
                method: 'native',
                device_type: getDeviceType()
              });
            }
          })
          .catch((err) => {
            // Handle specific errors
            if (err.name === 'AbortError') {
              // User cancelled - do nothing
              return;
            }
            
            // For other errors (NotAllowedError, DataError, etc.), fall back to custom modal
            openShareModal(shareUrl, conversionText);
          });
