---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const title = "Age Calculator";
const categoryTitle = "Date & Time Calculators";
const description = "Calculate your exact age in years, months, and days. Find out the exact duration between any two dates instantly.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Date of Birth -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Date of Birth</label>
                <input
                  id="dob-input"
                  type="date"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

              <!-- Target Date -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Calculate age at</label>
                <input
                  id="target-input"
                  type="date"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Invalid date sequence (Birth date must be before target date).</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center">
               <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-4">Exact Age</span>
               
               <div class="flex items-center justify-center gap-4 sm:gap-8 flex-wrap">
                 <div>
                   <div id="res-years" class="text-4xl sm:text-5xl font-bold text-primary tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Years</div>
                 </div>
                 <div class="text-3xl text-hairline-strong font-light mb-4">/</div>
                 <div>
                   <div id="res-months" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Months</div>
                 </div>
                 <div class="text-3xl text-hairline-strong font-light mb-4">/</div>
                 <div>
                   <div id="res-days" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Days</div>
                 </div>
               </div>

            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Calculation Note</h3>
          <p class="text-sm text-body leading-relaxed mb-4">
            This tool computes the precise difference between two dates, accurately factoring in leap years and the varying lengths of each month.
          </p>
        </div>
      </aside>

    </div>

    <!-- SEO Optimization Guide / FAQ -->
    <div class="mt-12 sm:mt-16 border-t border-hairline pt-12 max-w-4xl">
      <h2 class="text-xl sm:text-2xl font-semibold text-ink mb-6">Chronological Age Calculation & FAQ Guide</h2>
      <div class="space-y-6 text-sm text-body leading-relaxed">
        <div>
          <h3 class="font-semibold text-ink mb-2">How do I calculate my exact age from date of birth?</h3>
          <p>
            To calculate your exact age in years, months, and days, simply enter your Date of Birth (DOB) and choose the target date (which defaults to today's date). Our online DOB calculator accurately computes the exact duration, automatically accounting for leap years, monthly date rollovers, and the varying lengths of each month (28, 30, or 31 days).
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">What is a Chronological Age Calculator?</h3>
          <p>
            A chronological age calculator is a utility tool that measures the absolute elapsed time since a person was born. It outputs the duration broken down into years, months, and days. This is highly useful for school registrations, legal forms, visa processing, insurance policies, and employment profiles that require precise age verification.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">How does the calculator handle Leap Years?</h3>
          <p>
            A leap year contains 366 days instead of 365. When you perform DOB calculations with our tool, the underlying algorithm checks if February 29th lies within the elapsed interval and adds the extra leap day automatically to maintain 100% mathematical precision.
          </p>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { calculateAge } from '../../utils/calculators/ageLogic';

  const dobInput = document.getElementById('dob-input') as HTMLInputElement;
  const targetInput = document.getElementById('target-input') as HTMLInputElement;
  
  const resYears = document.getElementById('res-years');
  const resMonths = document.getElementById('res-months');
  const resDays = document.getElementById('res-days');
  const errMsg = document.getElementById('error-msg');

  // Set default dates
  const today = new Date().toISOString().split('T')[0];
  const defaultDob = new Date();
  defaultDob.setFullYear(defaultDob.getFullYear() - 25);
  
  dobInput.value = defaultDob.toISOString().split('T')[0];
  targetInput.value = today;

  function calculate() {
    const dob = dobInput.value;
    const target = targetInput.value;

    if (!dob || !target) {
      resYears!.textContent = '—';
      resMonths!.textContent = '—';
      resDays!.textContent = '—';
      errMsg!.classList.add('hidden');
      return;
    }
    
    const age = calculateAge(dob, target);

    if (age === null) {
      resYears!.textContent = '—';
      resMonths!.textContent = '—';
      resDays!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    errMsg!.classList.add('hidden');
    resYears!.textContent = age.years.toString();
    resMonths!.textContent = age.months.toString();
    resDays!.textContent = age.days.toString();
  }

  dobInput.addEventListener('input', calculate);
  targetInput.addEventListener('input', calculate);

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
