---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';

const title = "GPA Calculator";
const categoryTitle = "Math Calculators";
const description = "Easily calculate your Grade Point Average (GPA) by entering your course credits and grades.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden flex flex-col">
          <div class="p-6 sm:p-8 md:p-10 space-y-6 flex-1">
            
            <div class="grid grid-cols-12 gap-4 pb-2 border-b border-hairline text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">
              <div class="col-span-6">Course Name (Optional)</div>
              <div class="col-span-3">Credits</div>
              <div class="col-span-3">Grade</div>
            </div>

            <div id="course-list" class="space-y-4">
               <!-- Rows will be injected here -->
            </div>

            <button id="add-course-btn" class="flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-hover transition-colors mt-4">
              <Icon name="hugeicons:add-circle" class="w-5 h-5" />
              Add Course
            </button>

          </div>

          <div class="bg-canvas-soft-2 border-t border-hairline p-6 sm:p-8 md:p-10 text-center space-y-6">
            
            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center mb-4">Please enter valid credits and grades.</div>

            <div>
              <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Your GPA</span>
              <div id="res-gpa" class="text-5xl font-bold text-primary tracking-tight">—</div>
            </div>

            <div class="flex justify-center gap-8 pt-4">
               <div>
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">Total Credits</span>
                 <div id="res-credits" class="text-2xl font-semibold text-ink">—</div>
               </div>
               <div>
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">Total Points</span>
                 <div id="res-points" class="text-2xl font-semibold text-ink">—</div>
               </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Grade Scale (Standard 4.0)</h3>
          <ul class="space-y-2 text-sm text-body">
            <li class="flex justify-between"><span>A (Excellent)</span> <strong>4.0</strong></li>
            <li class="flex justify-between"><span>B (Good)</span> <strong>3.0</strong></li>
            <li class="flex justify-between"><span>C (Average)</span> <strong>2.0</strong></li>
            <li class="flex justify-between"><span>D (Poor)</span> <strong>1.0</strong></li>
            <li class="flex justify-between"><span>F (Fail)</span> <strong>0.0</strong></li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<template id="course-row-template">
  <div class="course-row grid grid-cols-12 gap-4 items-center group relative">
    <div class="col-span-6">
      <input type="text" placeholder="Course" class="w-full h-10 px-3 bg-canvas-soft border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-hairline-strong transition-all" />
    </div>
    <div class="col-span-3">
      <input type="number" min="1" value="3" class="course-credits w-full h-10 px-3 bg-canvas-soft border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-hairline-strong transition-all" />
    </div>
    <div class="col-span-3 relative">
      <Dropdown
        class="course-grade w-full"
        options={[
          { key: '4.0', label: 'A' },
          { key: '3.0', label: 'B' },
          { key: '2.0', label: 'C' },
          { key: '1.0', label: 'D' },
          { key: '0.0', label: 'F' }
        ]}
        selected="4.0"
      />
    </div>
    
    <button type="button" class="remove-btn absolute -right-8 top-1/2 -translate-y-1/2 text-mute hover:text-red-500 opacity-0 group-hover:opacity-100 transition-all p-1" title="Remove course">
      <Icon name="hugeicons:cancel-01" class="w-5 h-5" />
    </button>
  </div>
</template>

<script>
  import { calculateGPA, type Course } from '../../utils/calculators/averageLogic';

  const courseList = document.getElementById('course-list')!;
  const addBtn = document.getElementById('add-course-btn')!;
  const template = document.getElementById('course-row-template') as HTMLTemplateElement;
  
  const resGpa = document.getElementById('res-gpa')!;
  const resCredits = document.getElementById('res-credits')!;
  const resPoints = document.getElementById('res-points')!;
  const errMsg = document.getElementById('error-msg')!;

  function calculate() {
    const rows = courseList.querySelectorAll('.course-row');
    const courses: Course[] = [];
    let totC = 0;
    let totP = 0;
    let hasError = false;

    rows.forEach(row => {
      const creditInput = row.querySelector('.course-credits') as HTMLInputElement;
      const gradeInput = row.querySelector('.course-grade') as any;
      
      const c = parseFloat(creditInput.value);
      const g = parseFloat(gradeInput.value);

      if (isNaN(c) || isNaN(g) || c <= 0) {
        hasError = true;
      } else {
        courses.push({ credits: c, gradePoint: g });
        totC += c;
        totP += (c * g);
      }
    });

    if (hasError || courses.length === 0) {
      resGpa.textContent = '—';
      resCredits.textContent = '—';
      resPoints.textContent = '—';
      errMsg.classList.remove('hidden');
      if (courses.length === 0) errMsg.classList.add('hidden');
      return;
    }

    errMsg.classList.add('hidden');
    const gpa = calculateGPA(courses);
    
    resGpa.textContent = gpa !== null ? gpa.toFixed(2) : '—';
    resCredits.textContent = totC.toString();
    resPoints.textContent = totP.toString();
  }

  function addCourseRow() {
    const clone = template.content.cloneNode(true) as DocumentFragment;
    const row = clone.querySelector('.course-row')!;
    
    const inputs = row.querySelectorAll('input, .custom-dropdown');
    inputs.forEach(input => input.addEventListener('change', calculate));
    inputs.forEach(input => {
      if (input.tagName === 'INPUT') input.addEventListener('input', calculate);
    });
    
    const removeBtn = row.querySelector('.remove-btn')!;
    removeBtn.addEventListener('click', () => {
      row.remove();
      calculate();
    });

    courseList.appendChild(clone);
    if ((window as any).initDropdowns) (window as any).initDropdowns();
    calculate();
  }

  addBtn.addEventListener('click', addCourseRow);

  // Initialize with 4 empty rows
  addCourseRow();
  addCourseRow();
  addCourseRow();
  addCourseRow();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>