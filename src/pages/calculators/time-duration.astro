---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const title = "Time Duration Calculator";
const categoryTitle = "Date & Time Calculators";
const description = "Calculate the exact hours and minutes between a start time and an end time. Automatically handles crossing midnight.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Start Time -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Start Time</label>
                <input
                  id="start-time"
                  type="time"
                  value="09:00"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

              <!-- End Time -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">End Time</label>
                <input
                  id="end-time"
                  type="time"
                  value="17:30"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please enter valid times.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center">
               <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-4">Duration</span>
               
               <div class="flex items-center justify-center gap-4 sm:gap-8 flex-wrap mb-6">
                 <div>
                   <div id="res-hours" class="text-4xl sm:text-5xl font-bold text-primary tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Hours</div>
                 </div>
                 <div class="text-3xl text-hairline-strong font-light mb-4">:</div>
                 <div>
                   <div id="res-minutes" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Minutes</div>
                 </div>
               </div>

               <div class="pt-4 border-t border-hairline">
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest">Total Minutes</span>
                 <div id="res-total" class="text-xl font-semibold text-ink mt-1">—</div>
               </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Midnight Crossing</h3>
          <p class="text-sm text-body leading-relaxed mb-4">
            If your end time is mathematically earlier than your start time (e.g. 10:00 PM to 6:00 AM), our logic automatically detects a midnight crossover and calculates the next-day duration.
          </p>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { calculateTimeDuration } from '../../utils/calculators/timeLogic';

  const t1Input = document.getElementById('start-time') as HTMLInputElement;
  const t2Input = document.getElementById('end-time') as HTMLInputElement;
  
  const resHours = document.getElementById('res-hours');
  const resMinutes = document.getElementById('res-minutes');
  const resTotal = document.getElementById('res-total');
  const errMsg = document.getElementById('error-msg');

  function calculate() {
    const t1 = t1Input.value;
    const t2 = t2Input.value;

    if (!t1 || !t2) {
      resHours!.textContent = '—';
      resMinutes!.textContent = '—';
      resTotal!.textContent = '—';
      errMsg!.classList.add('hidden');
      return;
    }
    
    const res = calculateTimeDuration(t1, t2);

    if (res === null) {
      resHours!.textContent = '—';
      resMinutes!.textContent = '—';
      resTotal!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    errMsg!.classList.add('hidden');
    resHours!.textContent = res.hours.toString();
    resMinutes!.textContent = res.minutes.toString().padStart(2, '0');
    resTotal!.textContent = res.totalMinutes.toLocaleString('en-US') + ' mins';
  }

  t1Input.addEventListener('input', calculate);
  t2Input.addEventListener('input', calculate);

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
