---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';

const title = "Compound Interest Calculator";
const categoryTitle = "Financial Calculators";
const description = "Calculate how your money grows over time with the power of compound interest.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Principal -->
              <div class="space-y-3 sm:col-span-2">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Initial Investment (Principal)</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-mute font-medium">$</span>
                  <input
                    id="principal-input"
                    type="number"
                    value="10000"
                    min="1"
                    class="w-full h-12 pl-8 pr-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                </div>
              </div>

              <!-- Rate -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Annual Interest Rate</label>
                <div class="relative">
                  <input
                    id="rate-input"
                    type="number"
                    value="5"
                    min="0"
                    step="0.1"
                    class="w-full h-12 pl-4 pr-8 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute font-medium">%</span>
                </div>
              </div>

              <!-- Compounding Frequency -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Compounded</label>
                <Dropdown
                  id="compound-input"
                  options={[
                    { key: '1', label: 'Annually (1/yr)' },
                    { key: '2', label: 'Semi-annually (2/yr)' },
                    { key: '4', label: 'Quarterly (4/yr)' },
                    { key: '12', label: 'Monthly (12/yr)' },
                    { key: '365', label: 'Daily (365/yr)' }
                  ]}
                  selected="12"
                  class="w-full"
                />
              </div>

              <!-- Time -->
              <div class="space-y-3 sm:col-span-2">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Time Period</label>
                <div class="flex gap-2">
                  <input
                    id="time-input"
                    type="number"
                    value="10"
                    min="1"
                    class="w-2/3 h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <Dropdown
                    id="time-unit"
                    options={[
                      { key: 'years', label: 'Years' },
                      { key: 'months', label: 'Months' }
                    ]}
                    selected="years"
                    class="w-1/3"
                  />
                </div>
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please enter valid positive values.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center flex flex-col sm:flex-row divide-y sm:divide-y-0 sm:divide-x divide-hairline">
               
               <div class="flex-1 pb-4 sm:pb-0 sm:pr-4 flex flex-col justify-center">
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Total Future Value</span>
                 <div id="res-total" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
               </div>

               <div class="flex-1 pt-4 sm:pt-0 sm:pl-4 flex flex-col justify-center">
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Total Interest Earned</span>
                 <div id="res-interest" class="text-2xl sm:text-3xl font-semibold text-green-500 tracking-tight">—</div>
               </div>

            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Formula</h3>
          <p class="text-sm text-body leading-relaxed mb-4">
            A = P(1 + r/n)<sup>nt</sup>
          </p>
          <ul class="space-y-1 text-xs text-mute">
            <li><strong>A</strong> is Future Value</li>
            <li><strong>P</strong> is Principal</li>
            <li><strong>r</strong> is decimal interest rate</li>
            <li><strong>n</strong> is compounds per year</li>
            <li><strong>t</strong> is time in years</li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { calculateCompoundInterest } from '../../utils/calculators/interestLogic';

  const pInput = document.getElementById('principal-input') as HTMLInputElement;
  const rInput = document.getElementById('rate-input') as HTMLInputElement;
  const cInput = document.getElementById('compound-input') as any;
  const tInput = document.getElementById('time-input') as HTMLInputElement;
  const tUnit = document.getElementById('time-unit') as any;
  
  const resTotal = document.getElementById('res-total');
  const resInterest = document.getElementById('res-interest');
  const errMsg = document.getElementById('error-msg');

  function calculate() {
    const p = parseFloat(pInput.value);
    const r = parseFloat(rInput.value);
    const c = parseFloat(cInput.value);
    const t = parseFloat(tInput.value);

    if (isNaN(p) || isNaN(r) || isNaN(c) || isNaN(t) || p < 0 || r < 0 || t < 0) {
      resTotal!.textContent = '—';
      resInterest!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }
    
    errMsg!.classList.add('hidden');

    let years = t;
    if (tUnit.value === 'months') years = t / 12;

    const res = calculateCompoundInterest(p, r, years, c);

    if (!res) {
      resTotal!.textContent = '—';
      resInterest!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    resTotal!.textContent = '$' + res.totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    resInterest!.textContent = '$' + res.interestAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  [pInput, rInput, cInput, tInput, tUnit].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });

  calculate();
</script>