---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const title = "Date Difference Calculator";
const categoryTitle = "Date & Time Calculators";
const description = "Calculate the exact number of years, months, and days between two dates.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Start Date -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Start Date</label>
                <input
                  id="start-input"
                  type="date"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

              <!-- End Date -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">End Date</label>
                <input
                  id="end-input"
                  type="date"
                  class="w-full h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                />
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please select valid dates.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center">
               <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-4">Time Difference</span>
               
               <div class="flex items-center justify-center gap-4 sm:gap-8 flex-wrap mb-6">
                 <div>
                   <div id="res-years" class="text-4xl sm:text-5xl font-bold text-primary tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Years</div>
                 </div>
                 <div class="text-3xl text-hairline-strong font-light mb-4">/</div>
                 <div>
                   <div id="res-months" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Months</div>
                 </div>
                 <div class="text-3xl text-hairline-strong font-light mb-4">/</div>
                 <div>
                   <div id="res-days" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight">—</div>
                   <div class="text-xs font-semibold text-mute uppercase tracking-wider mt-2">Days</div>
                 </div>
               </div>

               <div class="grid grid-cols-2 gap-4 pt-4 border-t border-hairline text-left">
                  <div class="bg-canvas border border-hairline rounded px-4 py-2">
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest">Total Days</span>
                    <div id="res-total-days" class="text-lg font-semibold text-ink">—</div>
                  </div>
                  <div class="bg-canvas border border-hairline rounded px-4 py-2">
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest">Total Weeks</span>
                    <div id="res-total-weeks" class="text-lg font-semibold text-ink">—</div>
                  </div>
               </div>

            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Leap Years Handled</h3>
          <p class="text-sm text-body leading-relaxed mb-4">
            Our engine automatically detects leap years and varying month lengths, calculating the exact literal difference between the two dates.
          </p>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { calculateDateDifference } from '../../utils/calculators/timeLogic';

  const d1Input = document.getElementById('start-input') as HTMLInputElement;
  const d2Input = document.getElementById('end-input') as HTMLInputElement;
  
  const resYears = document.getElementById('res-years');
  const resMonths = document.getElementById('res-months');
  const resDays = document.getElementById('res-days');
  const resTotalDays = document.getElementById('res-total-days');
  const resTotalWeeks = document.getElementById('res-total-weeks');
  const errMsg = document.getElementById('error-msg');

  // Set default dates
  const today = new Date();
  const nextMonth = new Date();
  nextMonth.setMonth(nextMonth.getMonth() + 1);
  
  d1Input.value = today.toISOString().split('T')[0];
  d2Input.value = nextMonth.toISOString().split('T')[0];

  function calculate() {
    const d1 = d1Input.value;
    const d2 = d2Input.value;

    if (!d1 || !d2) {
      resYears!.textContent = '—';
      resMonths!.textContent = '—';
      resDays!.textContent = '—';
      resTotalDays!.textContent = '—';
      resTotalWeeks!.textContent = '—';
      errMsg!.classList.add('hidden');
      return;
    }
    
    const res = calculateDateDifference(d1, d2);

    if (res === null) {
      resYears!.textContent = '—';
      resMonths!.textContent = '—';
      resDays!.textContent = '—';
      resTotalDays!.textContent = '—';
      resTotalWeeks!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    errMsg!.classList.add('hidden');
    resYears!.textContent = res.years.toString();
    resMonths!.textContent = res.months.toString();
    resDays!.textContent = res.days.toString();
    resTotalDays!.textContent = res.totalDays.toLocaleString('en-US') + ' Days';
    resTotalWeeks!.textContent = res.totalWeeks.toLocaleString('en-US') + ' Weeks';
  }

  d1Input.addEventListener('input', calculate);
  d2Input.addEventListener('input', calculate);

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
