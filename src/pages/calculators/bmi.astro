---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';

const title = "BMI Calculator";
const categoryTitle = "Health Calculators";
const description = "Calculate your Body Mass Index (BMI) instantly. Supports both metric and imperial units with health classification.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Height -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Height</label>
                <div class="flex gap-2">
                  <input
                    id="height-input"
                    type="number"
                    value="175"
                    min="1"
                    placeholder="e.g. 175"
                    class="w-2/3 h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <Dropdown 
                    id="height-unit" 
                    options={[
                      { key: 'cm', label: 'cm' },
                      { key: 'm', label: 'm' },
                      { key: 'in', label: 'inches' }
                    ]} 
                    selected="cm"
                    class="w-1/3" 
                  />
                </div>
              </div>

              <!-- Weight -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Weight</label>
                <div class="flex gap-2">
                  <input
                    id="weight-input"
                    type="number"
                    value="70"
                    min="1"
                    placeholder="e.g. 70"
                    class="w-2/3 h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <Dropdown 
                    id="weight-unit" 
                    options={[
                      { key: 'kg', label: 'kg' },
                      { key: 'lbs', label: 'lbs' }
                    ]} 
                    selected="kg"
                    class="w-1/3" 
                  />
                </div>
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please enter valid positive numbers.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center">
               <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Your BMI</span>
               <div id="bmi-result" class="text-4xl sm:text-5xl font-bold text-ink tracking-tight mb-2">—</div>
               <div id="bmi-category" class="text-lg font-medium text-mute">—</div>
            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">BMI Categories</h3>
          <ul class="space-y-3 text-sm">
             <li class="flex justify-between"><span class="text-body">Underweight</span> <span class="font-mono text-blue-500">&lt; 18.5</span></li>
             <li class="flex justify-between"><span class="text-body">Normal</span> <span class="font-mono text-green-500">18.5 - 24.9</span></li>
             <li class="flex justify-between"><span class="text-body">Overweight</span> <span class="font-mono text-orange-500">25 - 29.9</span></li>
             <li class="flex justify-between"><span class="text-body">Obesity</span> <span class="font-mono text-red-500">&ge; 30.0</span></li>
          </ul>
        </div>
      </aside>

    </div>

    <!-- SEO Optimization Guide / FAQ -->
    <div class="mt-12 sm:mt-16 border-t border-hairline pt-12 max-w-4xl">
      <h2 class="text-xl sm:text-2xl font-semibold text-ink mb-6">Body Mass Index (BMI) Reference & FAQ Guide</h2>
      <div class="space-y-6 text-sm text-body leading-relaxed">
        <div>
          <h3 class="font-semibold text-ink mb-2">How is BMI calculated? (The Formula)</h3>
          <p>
            Your Body Mass Index (BMI) is calculated by dividing your weight in kilograms by the square of your height in meters. 
            <br />
            <code class="font-mono text-xs bg-canvas-soft-2 px-2 py-1 rounded inline-block mt-2 text-ink">BMI = weight (kg) / [height (m)]²</code>
            <br />
            For imperial measurements, the formula is:
            <br />
            <code class="font-mono text-xs bg-canvas-soft-2 px-2 py-1 rounded inline-block mt-2 text-ink">BMI = [weight (lbs) / [height (inches)]²] &times; 703</code>
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">What are the standard weight classifications?</h3>
          <p>
            According to the World Health Organization (WHO), adults over 20 are categorized under the following values:
            <ul class="list-disc pl-5 mt-2 space-y-1">
              <li><strong>Underweight (BMI &lt; 18.5):</strong> Indicates potential undernutrition or related metabolic conditions.</li>
              <li><strong>Normal range (BMI 18.5 – 24.9):</strong> Associated with the lowest risk of weight-related health diseases.</li>
              <li><strong>Overweight (BMI 25.0 – 29.9):</strong> Suggests a mild to moderate excess body weight.</li>
              <li><strong>Obese (BMI &ge; 30.0):</strong> Indicates significant excess body weight, associated with higher risks of cardiovascular issues.</li>
            </ul>
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">Is the BMI calculator accurate for everyone?</h3>
          <p>
            While BMI is an excellent general screening tool for most adults, it has limitations. It does not directly measure body fat percentage. Athletes or individuals with high muscle mass may receive an "overweight" or "obese" score because muscle weighs more than fat, despite having low body fat. It is also less accurate for pregnant women and growing children.
          </p>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { calculateBMI } from '../../utils/calculators/bmiLogic';

  const hInput = document.getElementById('height-input') as HTMLInputElement;
  const hUnit = document.getElementById('height-unit') as HTMLSelectElement;
  const wInput = document.getElementById('weight-input') as HTMLInputElement;
  const wUnit = document.getElementById('weight-unit') as HTMLSelectElement;
  
  const resBmi = document.getElementById('bmi-result');
  const resCat = document.getElementById('bmi-category');
  const errMsg = document.getElementById('error-msg');

  function calculate() {
    const h = parseFloat(hInput.value);
    const w = parseFloat(wInput.value);

    if (isNaN(h) || isNaN(w) || h <= 0 || w <= 0) {
      resBmi!.textContent = '—';
      resCat!.textContent = '—';
      resCat!.className = 'text-lg font-medium text-mute';
      errMsg!.classList.remove('hidden');
      return;
    }
    
    errMsg!.classList.add('hidden');

    let heightCm = h;
    if (hUnit.value === 'm') heightCm = h * 100;
    if (hUnit.value === 'in') heightCm = h * 2.54;

    let weightKg = w;
    if (wUnit.value === 'lbs') weightKg = w * 0.45359237;

    const res = calculateBMI(weightKg, heightCm);

    if (!res) {
      resBmi!.textContent = '—';
      resCat!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    resBmi!.textContent = res.bmi.toString();
    resCat!.textContent = res.category;
    resCat!.className = `text-lg font-medium ${res.colorClass}`;
  }

  [hInput, hUnit, wInput, wUnit].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
