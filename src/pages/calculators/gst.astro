---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const title = "GST Calculator";
const categoryTitle = "Financial Calculators";
const description = "Instantly add or remove Goods and Services Tax (GST) from any price. Supports standard worldwide tax brackets.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">

              <!-- Action Toggle -->
              <div class="space-y-3 sm:col-span-2">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Action</label>
                <div class="flex gap-4">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="gstAction" value="add" checked class="peer sr-only" />
                    <div class="h-12 flex items-center justify-center border border-hairline rounded-sm bg-canvas-soft peer-checked:bg-primary/10 peer-checked:border-primary peer-checked:text-primary transition-all font-medium text-ink">
                      Add GST (Exclusive)
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="gstAction" value="remove" class="peer sr-only" />
                    <div class="h-12 flex items-center justify-center border border-hairline rounded-sm bg-canvas-soft peer-checked:bg-primary/10 peer-checked:border-primary peer-checked:text-primary transition-all font-medium text-ink">
                      Remove GST (Inclusive)
                    </div>
                  </label>
                </div>
              </div>
              
              <!-- Initial Amount -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Initial Amount</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-mute font-medium">$</span>
                  <input
                    id="price-input"
                    type="number"
                    value="100"
                    min="0"
                    step="0.01"
                    class="w-full h-12 pl-8 pr-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                </div>
              </div>

              <!-- GST Rate -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">GST Rate</label>
                <div class="relative">
                  <input
                    id="rate-input"
                    type="number"
                    value="18"
                    min="0"
                    step="0.1"
                    class="w-full h-12 pl-4 pr-8 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute font-medium">%</span>
                </div>
              </div>

              <!-- Quick Rates -->
              <div class="sm:col-span-2 flex flex-wrap gap-2">
                <button type="button" class="quick-rate px-3 py-1.5 text-xs font-medium bg-canvas-soft border border-hairline rounded-md hover:border-primary hover:text-primary transition-colors" data-rate="3">3%</button>
                <button type="button" class="quick-rate px-3 py-1.5 text-xs font-medium bg-canvas-soft border border-hairline rounded-md hover:border-primary hover:text-primary transition-colors" data-rate="5">5%</button>
                <button type="button" class="quick-rate px-3 py-1.5 text-xs font-medium bg-canvas-soft border border-hairline rounded-md hover:border-primary hover:text-primary transition-colors" data-rate="12">12%</button>
                <button type="button" class="quick-rate px-3 py-1.5 text-xs font-medium bg-canvas-soft border border-hairline rounded-md hover:border-primary hover:text-primary transition-colors bg-primary/5 border-primary text-primary" data-rate="18">18%</button>
                <button type="button" class="quick-rate px-3 py-1.5 text-xs font-medium bg-canvas-soft border border-hairline rounded-md hover:border-primary hover:text-primary transition-colors" data-rate="28">28%</button>
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please enter valid positive values.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center space-y-6">
               
               <div>
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Net Price (Without GST)</span>
                 <div id="res-net" class="text-3xl font-bold text-ink tracking-tight">—</div>
               </div>

               <div class="grid grid-cols-2 gap-4 pt-4 border-t border-hairline">
                  <div>
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">GST Amount</span>
                    <div id="res-tax" class="text-xl sm:text-2xl font-bold text-orange-500 tracking-tight">—</div>
                  </div>
                  <div>
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">Gross Price (With GST)</span>
                    <div id="res-gross" class="text-xl sm:text-2xl font-bold text-primary tracking-tight">—</div>
                  </div>
               </div>

            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">Adding vs Removing</h3>
          <ul class="space-y-3 text-sm text-body">
            <li><strong>Adding GST:</strong> The amount you entered is the base price. Tax is calculated on top of it.</li>
            <li><strong>Removing GST:</strong> The amount you entered already includes tax. This breaks down how much of that price was tax and what the base price was.</li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { calculateGST } from '../../utils/calculators/gstLogic';

  const priceInput = document.getElementById('price-input') as HTMLInputElement;
  const rateInput = document.getElementById('rate-input') as HTMLInputElement;
  const actionInputs = document.querySelectorAll('input[name="gstAction"]');
  const quickRates = document.querySelectorAll('.quick-rate');
  
  const resNet = document.getElementById('res-net');
  const resTax = document.getElementById('res-tax');
  const resGross = document.getElementById('res-gross');
  const errMsg = document.getElementById('error-msg');

  function updateQuickRateStyles() {
    quickRates.forEach(btn => {
      if (btn.getAttribute('data-rate') === rateInput.value) {
        btn.classList.add('bg-primary/5', 'border-primary', 'text-primary');
      } else {
        btn.classList.remove('bg-primary/5', 'border-primary', 'text-primary');
      }
    });
  }

  function calculate() {
    const p = parseFloat(priceInput.value);
    const r = parseFloat(rateInput.value);
    const action = (document.querySelector('input[name="gstAction"]:checked') as HTMLInputElement).value as 'add' | 'remove';

    updateQuickRateStyles();

    if (isNaN(p) || isNaN(r) || p < 0 || r < 0) {
      resNet!.textContent = '—';
      resTax!.textContent = '—';
      resGross!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }
    
    errMsg!.classList.add('hidden');

    const res = calculateGST(p, r, action);

    if (!res) {
      resNet!.textContent = '—';
      resTax!.textContent = '—';
      resGross!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    resNet!.textContent = '$' + res.netPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    resTax!.textContent = '$' + res.gstAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    resGross!.textContent = '$' + res.grossPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  quickRates.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const rate = (e.currentTarget as HTMLButtonElement).getAttribute('data-rate');
      if (rate) {
        rateInput.value = rate;
        calculate();
      }
    });
  });

  const elements = [priceInput, rateInput, ...Array.from(actionInputs)];
  elements.forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
