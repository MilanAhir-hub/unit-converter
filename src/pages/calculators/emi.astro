---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';

const title = "EMI Calculator";
const categoryTitle = "Financial Calculators";
const description = "Calculate your Equated Monthly Installment (EMI) for home loans, car loans, or personal loans using banking standards.";

---

<Layout title={`${title} — Free Online Calculator`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- Page Header -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Calculator Main -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-8">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
              
              <!-- Principal -->
              <div class="space-y-3 sm:col-span-2">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Loan Amount</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-mute font-medium">$</span>
                  <input
                    id="principal-input"
                    type="number"
                    value="25000"
                    min="1"
                    class="w-full h-12 pl-8 pr-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                </div>
              </div>

              <!-- Interest Rate -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Interest Rate (p.a.)</label>
                <div class="relative">
                  <input
                    id="rate-input"
                    type="number"
                    value="8.5"
                    min="0"
                    max="100"
                    step="0.1"
                    class="w-full h-12 pl-4 pr-8 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute font-medium">%</span>
                </div>
              </div>

              <!-- Term -->
              <div class="space-y-3">
                <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Loan Tenure</label>
                <div class="flex gap-2">
                  <input
                    id="term-input"
                    type="number"
                    value="5"
                    min="1"
                    class="w-2/3 h-12 px-4 bg-canvas-soft border border-hairline rounded-sm text-lg font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
                  />
                  <Dropdown
                    id="term-unit"
                    options={[
                      { key: 'years', label: 'Years' },
                      { key: 'months', label: 'Months' }
                    ]}
                    selected="years"
                    class="w-1/3"
                  />
                </div>
              </div>

            </div>

            <div id="error-msg" class="text-red-500 text-sm font-medium hidden text-center">Please enter valid positive values.</div>

            <hr class="border-hairline" />

            <!-- Result -->
            <div class="bg-canvas-soft-2 border border-hairline p-6 rounded-md text-center space-y-6">
               
               <div>
                 <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-2">Monthly EMI</span>
                 <div id="res-emi" class="text-4xl sm:text-5xl font-bold text-primary tracking-tight">—</div>
               </div>

               <div class="grid grid-cols-2 gap-4 pt-4 border-t border-hairline">
                  <div>
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">Total Interest</span>
                    <div id="res-interest" class="text-xl sm:text-2xl font-bold text-orange-500 tracking-tight">—</div>
                  </div>
                  <div>
                    <span class="block text-[10px] font-mono text-mute uppercase tracking-widest mb-1.5">Total Payment</span>
                    <div id="res-total" class="text-xl sm:text-2xl font-bold text-ink tracking-tight">—</div>
                  </div>
               </div>

            </div>

          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-4">EMI Formula</h3>
          <p class="text-sm text-body leading-relaxed mb-4">
            E = P × r × (1+r)<sup>n</sup> / ((1+r)<sup>n</sup> - 1)
          </p>
          <ul class="space-y-1 text-xs text-mute">
            <li><strong>E</strong> is EMI</li>
            <li><strong>P</strong> is Principal</li>
            <li><strong>r</strong> is monthly interest rate</li>
            <li><strong>n</strong> is tenure in months</li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { calculateLoan } from '../../utils/calculators/loanLogic';

  const pInput = document.getElementById('principal-input') as HTMLInputElement;
  const rInput = document.getElementById('rate-input') as HTMLInputElement;
  const tInput = document.getElementById('term-input') as HTMLInputElement;
  const tUnit = document.getElementById('term-unit') as any;
  
  const resEmi = document.getElementById('res-emi');
  const resTotal = document.getElementById('res-total');
  const resInterest = document.getElementById('res-interest');
  const errMsg = document.getElementById('error-msg');

  function calculate() {
    const p = parseFloat(pInput.value);
    const r = parseFloat(rInput.value);
    const t = parseFloat(tInput.value);

    if (isNaN(p) || isNaN(r) || isNaN(t) || p <= 0 || r < 0 || t <= 0) {
      resEmi!.textContent = '—';
      resTotal!.textContent = '—';
      resInterest!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }
    
    errMsg!.classList.add('hidden');

    let months = t;
    if (tUnit.value === 'years') months = t * 12;

    const res = calculateLoan(p, r, months);

    if (!res) {
      resEmi!.textContent = '—';
      resTotal!.textContent = '—';
      resInterest!.textContent = '—';
      errMsg!.classList.remove('hidden');
      return;
    }

    resEmi!.textContent = '$' + res.emi.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    resTotal!.textContent = '$' + res.totalPayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    resInterest!.textContent = '$' + res.totalInterest.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  [pInput, rInput, tInput, tUnit].forEach(el => {
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
  });

  // Initial calculation
  calculate();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>