---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const categories = [...new Set(blogEntries.map(entry => entry.data.category))];
  
  return categories.map(category => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category, entries: blogEntries.filter(entry => entry.data.category === category) },
  }));
}

let { category, entries } = Astro.props;
const { category: paramCategory } = Astro.params;

if (!entries && paramCategory) {
  const blogEntries = await getCollection('blog');
  const match = blogEntries.find(entry => 
    entry.data.category.toLowerCase().replace(/\s+/g, '-') === paramCategory
  );
  if (match) {
    category = match.data.category;
    entries = blogEntries.filter(entry => entry.data.category === category);
  }
}

if (!category || !entries) {
  return Astro.redirect('/404');
}

const sortedEntries = entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${category} Guides & Resources — Real Unit Converter`;
const description = `Explore our comprehensive collection of articles and guides about ${category}. Learn formulas, history, and technical details.`;

const locale = Astro.currentLocale || 'en';
const getLocalizedHref = (url: string) => {
  if (locale === 'en') return url;
  if (url.startsWith(`/${locale}`)) return url;
  return `/${locale}${url}`;
};
---

<Layout title={title} description={description}>
  <div class="max-w-6xl mx-auto py-8 sm:py-12 md:py-16 px-4">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-8 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest" aria-label="Breadcrumb">
      <a href={getLocalizedHref("/")} class="hover:text-primary transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 text-hairline" />
      <a href={getLocalizedHref("/blog")} class="hover:text-primary transition-colors">Blog</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 text-hairline" />
      <span class="text-ink truncate">{category}</span>
    </nav>

    <!-- Header -->
    <header class="mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-[10px] sm:text-[11px] font-mono text-primary uppercase tracking-widest mb-4">
        Category
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-[-0.04em] text-ink mb-6 leading-tight">
        {category}
      </h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm sm:text-base">
        Deep dives and educational resources focused on {category.toLowerCase()}. Everything you need to know about these measurements in one place.
      </p>
    </header>

    <!-- Articles List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {sortedEntries.map((article) => (
        <article class="flex flex-col bg-canvas border border-hairline rounded-xl overflow-hidden hover:border-hairline-strong transition-all duration-200 group">
          <div class="p-6 sm:p-8 flex flex-col flex-grow">
            <div class="flex items-center justify-between text-[10px] font-mono text-mute uppercase tracking-wider mb-4">
              <span class="text-primary font-bold">{article.data.category}</span>
              <span>{article.data.readTime}</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-3 group-hover:text-primary transition-colors leading-snug">
              {article.data.title}
            </h3>
            <p class="text-body text-xs sm:text-sm leading-relaxed mb-6 flex-grow line-clamp-3">
              {article.data.description}
            </p>
            <a 
              href={getLocalizedHref(`/blog/${article.id}`)}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:underline mt-auto self-start"
            >
              Read Full Guide
              <Icon name="hugeicons:arrow-right-01" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>
