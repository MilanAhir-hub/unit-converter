---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import {
  convert,
  formatResult,
  getCategoryBySlug
} from '../../utils/converter';
import {
  findUnitAndCategory,
  getUnitSEOData,
  generateEducationalContent,
  generateFAQs,
  generateSchemas
} from '../../utils/seoContent';

export async function getStaticPaths() {
  const commonValues = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000];
  const commonPairs = [
    // Length
    { from: 'inch', to: 'centimeter', fromUrl: 'inch', toUrl: 'cm' },
    { from: 'centimeter', to: 'inch', fromUrl: 'cm', toUrl: 'inch' },
    { from: 'mile', to: 'kilometer', fromUrl: 'mile', toUrl: 'km' },
    { from: 'kilometer', to: 'mile', fromUrl: 'km', toUrl: 'mile' },
    { from: 'foot', to: 'meter', fromUrl: 'feet', toUrl: 'meters' },
    { from: 'meter', to: 'foot', fromUrl: 'meters', toUrl: 'feet' },
    { from: 'yard', to: 'meter', fromUrl: 'yards', toUrl: 'meters' },
    { from: 'foot', to: 'inch', fromUrl: 'feet', toUrl: 'inches' },
    
    // Weight & Mass
    { from: 'kilogram', to: 'pound', fromUrl: 'kg', toUrl: 'lbs' },
    { from: 'pound', to: 'kilogram', fromUrl: 'lbs', toUrl: 'kg' },
    { from: 'gram', to: 'ounce', fromUrl: 'grams', toUrl: 'oz' },
    { from: 'ounce', to: 'gram', fromUrl: 'oz', toUrl: 'grams' },
    
    // Temperature
    { from: 'celsius', to: 'fahrenheit', fromUrl: 'celsius', toUrl: 'fahrenheit' },
    { from: 'fahrenheit', to: 'celsius', fromUrl: 'fahrenheit', toUrl: 'celsius' },
    
    // Volume
    { from: 'liter', to: 'gallon-us', fromUrl: 'liters', toUrl: 'gallons' },
    { from: 'gallon-us', to: 'liter', fromUrl: 'gallons', toUrl: 'liters' },
    { from: 'milliliter', to: 'fluid-ounce-us', fromUrl: 'ml', toUrl: 'fluid-ounces' },
    
    // Area
    { from: 'square-foot', to: 'square-meter', fromUrl: 'square-feet', toUrl: 'square-meters' },
    { from: 'square-meter', to: 'square-foot', fromUrl: 'square-meters', toUrl: 'square-feet' },
    { from: 'acre', to: 'square-meter', fromUrl: 'acres', toUrl: 'square-meters' },
    
    // Speed
    { from: 'kmh', to: 'mph', fromUrl: 'kmh', toUrl: 'mph' },
    { from: 'mph', to: 'kmh', fromUrl: 'mph', toUrl: 'kmh' },
    
    // Time
    { from: 'hour', to: 'minute', fromUrl: 'hours', toUrl: 'minutes' },
    { from: 'minute', to: 'second', fromUrl: 'minutes', toUrl: 'seconds' },
    
    // Data Storage
    { from: 'gigabyte', to: 'megabyte', fromUrl: 'gb', toUrl: 'mb' },
    { from: 'terabyte', to: 'gigabyte', fromUrl: 'tb', toUrl: 'gb' },
    
    // Power
    { from: 'kilowatt', to: 'horsepower', fromUrl: 'kw', toUrl: 'hp' },
    { from: 'horsepower', to: 'kilowatt', fromUrl: 'hp', toUrl: 'kw' }
  ];

  const paths = [];

  for (const val of commonValues) {
    for (const pair of commonPairs) {
      const fromRes = findUnitAndCategory(pair.from);
      const toRes = findUnitAndCategory(pair.to);
      if (fromRes && toRes && fromRes.category.slug === toRes.category.slug) {
        const category = fromRes.category;
        const fromUnit = fromRes.unit;
        const toUnit = toRes.unit;
        const slug = `${val}-${pair.fromUrl}-to-${pair.toUrl}`;
        
        let convertedVal = NaN;
        try {
          convertedVal = convert(val, fromUnit.key, toUnit.key, category);
        } catch (_) {}
        
        const resultStr = formatResult(convertedVal);
        
        paths.push({
          params: { slug },
          props: {
            value: val,
            fromUnitKey: fromUnit.key,
            toUnitKey: toUnit.key,
            categorySlug: category.slug,
            resultStr,
            fromUrl: pair.fromUrl,
            toUrl: pair.toUrl
          }
        });
      }
    }
  }

  return paths;
}

let {
  value,
  fromUnitKey,
  toUnitKey,
  categorySlug,
  resultStr,
  fromUrl,
  toUrl
} = Astro.props;

// If we are dynamically rendering (in SSR mode), Astro.props is empty
if (value === undefined) {
  const { slug } = Astro.params;
  if (slug) {
    const match = slug.match(/^([\d.]+)-(.*)-to-(.*)$/);
    if (match) {
      const parsedVal = parseFloat(match[1]);
      const parsedFrom = match[2];
      const parsedTo = match[3];

      const fromRes = findUnitAndCategory(parsedFrom);
      const toRes = findUnitAndCategory(parsedTo);

      if (fromRes && toRes && fromRes.category.slug === toRes.category.slug) {
        value = parsedVal;
        fromUrl = parsedFrom;
        toUrl = parsedTo;
        fromUnitKey = fromRes.unit.key;
        toUnitKey = toRes.unit.key;
        categorySlug = fromRes.category.slug;

        let convertedVal = NaN;
        try {
          convertedVal = convert(value, fromUnitKey, toUnitKey, fromRes.category);
        } catch (_) {}
        resultStr = formatResult(convertedVal);
      }
    }
  }
}

// Look up details
const categoryDef = categorySlug ? getCategoryBySlug(categorySlug) : null;
const fromUnit = categoryDef ? categoryDef.units.find(u => u.key === fromUnitKey) : null;
const toUnit = categoryDef ? categoryDef.units.find(u => u.key === toUnitKey) : null;

if (!categoryDef || !fromUnit || !toUnit) {
  return Astro.redirect('/404');
}

const fromMeta = getUnitSEOData(fromUnit);
const toMeta = getUnitSEOData(toUnit);
const fromLabel = value === 1 ? fromMeta.singular : fromMeta.plural;

import { t, translateCategory, translateUnit, translatePopularRoute } from '../../utils/i18n';
const locale = Astro.currentLocale || 'en';

const getLocalizedHref = (url: string) => {
  if (locale === 'en') return url;
  if (url.startsWith(`/${locale}`)) return url;
  return `/${locale}${url}`;
};

const localizedFromUnitLabel = translateUnit(fromUnit.key, locale, fromUnit.label);
const localizedToUnitLabel = translateUnit(toUnit.key, locale, toUnit.label);
const localizedCategoryTitle = translateCategory(categoryDef.slug, locale);

// Page titles & meta descriptors
const pageTitle = `${value} ${localizedFromUnitLabel} to ${localizedToUnitLabel} Converter | ${value} ${fromUnit.symbol || localizedFromUnitLabel} = ${resultStr} ${toUnit.symbol || localizedToUnitLabel}`;
const pageDescription = `Convert ${value} ${localizedFromUnitLabel} to ${localizedToUnitLabel} (${toUnit.symbol || localizedToUnitLabel}) instantly. Learn the formula, calculation steps, FAQs, and conversion examples.`;

const canonicalUrl = `https://realunitconverter.com/convert/${value}-${fromUrl}-to-${toUrl}`;

// Generate dynamic educational content & FAQs
let multiplier = '1';
if (fromUnit.factor && toUnit.factor) {
  multiplier = parseFloat((fromUnit.factor / toUnit.factor).toFixed(8)).toString();
}

const eduContent = generateEducationalContent(value, fromUnit, toUnit, categoryDef, parseFloat(multiplier));
const faqs = generateFAQs(value, fromUnit, toUnit, categoryDef, resultStr);
const schemas = generateSchemas(value, fromUnit, toUnit, categoryDef, resultStr, canonicalUrl, pageTitle, pageDescription);

// Related internal links
const relatedLinks = [
  { href: `/convert/1-${toUrl}-to-${fromUrl}`, label: `1 ${toMeta.singular} to ${fromMeta.plural}` },
  ...[5, 10, 50, 100].filter(v => v !== value).map(v => ({
    href: `/convert/${v}-${fromUrl}-to-${toUrl}`,
    label: `${v} ${fromMeta.plural} to ${toMeta.plural}`
  })),
  ...(categoryDef.slug === 'length' && fromUrl !== 'mile' ? [
    { href: `/convert/1-mile-to-km`, label: `1 Mile to Kilometers` }
  ] : []),
  ...(categoryDef.slug === 'weight-mass' && fromUrl !== 'kg' ? [
    { href: `/convert/1-kg-to-lbs`, label: `1 Kilogram to Pounds` }
  ] : [])
];

const localizedRelatedLinks = relatedLinks.map(link => ({
  ...link,
  href: getLocalizedHref(link.href)
}));
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Structured Schema Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas.breadcrumbs)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas.howTo)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas.faqPage)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas.webPage)} />

  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href={getLocalizedHref("/")} class="hover:text-ink transition-colors">{t('nav_home', locale)}</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <a href={getLocalizedHref(`/unit-converters/${categoryDef.slug}`)} class="hover:text-ink transition-colors">{localizedCategoryTitle}</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{value} {fromUnit.symbol || localizedFromUnitLabel} to {toUnit.symbol || localizedToUnitLabel}</span>
    </nav>

    <!-- Header Title -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">
        {value} {localizedFromUnitLabel} to {localizedToUnitLabel} {t('nav_converters', locale).split(' ').pop() || 'Conversion'}
      </h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">
        {locale === 'es' && `Calcule instantáneamente la conversión de ${value} ${localizedFromUnitLabel} a ${localizedToUnitLabel} con nuestra fórmula matemática detallada, pasos de cálculo y guía educativa.`}
        {locale === 'hi' && `हमारे विस्तृत गणितीय सूत्र, गणना चरणों और शैक्षिक मार्गदर्शिका के साथ तुरंत ${value} ${localizedFromUnitLabel} से ${localizedToUnitLabel} के रूपांतरण की गणना करें।`}
        {locale === 'fr' && `Calculez instantanément la conversion de ${value} ${localizedFromUnitLabel} en ${localizedToUnitLabel} grâce à notre formule mathématique détaillée, nos étapes de calcul et notre guide pédagogique.`}
        {locale === 'pt' && `Calcule instantaneamente a conversão de ${value} ${localizedFromUnitLabel} para ${localizedToUnitLabel} com nossa fórmula matemática detalhada, etapas de cálculo e guia educacional.`}
        {locale === 'de' && `Berechnen Sie sofort die Umrechnung von ${value} ${localizedFromUnitLabel} in ${localizedToUnitLabel} mit unserer detaillierten mathematischen Formel, Berechnungsschritten und unserem Leitfaden.`}
        {locale === 'ar' && `احسب على الفور تحويل ${value} ${localizedFromUnitLabel} إلى ${localizedToUnitLabel} باستخدام الصيغة الرياضية المفصلة وخطوات الحساب والدليل التعليمي.`}
        {locale === 'ja' && `詳細な数式、計算手順、解説ガイドを使用して、${value} ${localizedFromUnitLabel} から ${localizedToUnitLabel} への変換を即座に計算します。`}
        {!['es', 'hi', 'fr', 'pt', 'de', 'ar', 'ja'].includes(locale) && `Instantly calculate the conversion of ${value} ${localizedFromUnitLabel} to ${localizedToUnitLabel} with our detailed mathematical formula, calculation steps, and educational guide.`}
      </p>
    </header>

    <!-- Above the fold featured snippet answer card -->
    <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden mb-8 sm:mb-10">
      <div class="p-6 sm:p-10 md:p-12 text-center border-b border-hairline bg-canvas-soft-2">
        <div class="text-[11px] font-mono text-mute uppercase tracking-widest mb-3">{t('instant_answer', locale)}</div>
        <div class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-primary mb-4 break-all">
          {value} {fromUnit.symbol || localizedFromUnitLabel} = {resultStr} {toUnit.symbol || localizedToUnitLabel}
        </div>
        <p class="text-base sm:text-lg text-ink font-medium max-w-2xl mx-auto leading-relaxed">
          {locale === 'es' && `${value} ${localizedFromUnitLabel} equivale a `}
          {locale === 'hi' && `${value} ${localizedFromUnitLabel} बराबर है `}
          {locale === 'fr' && `${value} ${localizedFromUnitLabel} équivaut à `}
          {locale === 'pt' && `${value} ${localizedFromUnitLabel} equivale a `}
          {locale === 'de' && `${value} ${localizedFromUnitLabel} entspricht `}
          {locale === 'ar' && `${value} ${localizedFromUnitLabel} يعادل `}
          {locale === 'ja' && `${value} ${localizedFromUnitLabel} は `}
          {!['es', 'hi', 'fr', 'pt', 'de', 'ar', 'ja'].includes(locale) && `${value} ${localizedFromUnitLabel} equals `}
          <span class="text-primary font-bold">{resultStr}</span> 
          {locale === 'ja' && ` に相当します。`}
          {locale !== 'ja' && ` ${localizedToUnitLabel}.`}
        </p>
      </div>

      <!-- Math Explanation & Formula details -->
      <div class="p-6 sm:p-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        <!-- Formula Section -->
        <div class="space-y-4">
          <h2 class="text-lg font-semibold text-ink flex items-center gap-2">
            <Icon name="hugeicons:settings-01" class="w-5 h-5 text-primary" />
            Conversion Formula
          </h2>
          <div class="p-4 bg-canvas-soft border border-hairline rounded-sm font-mono text-center">
            {categoryDef.slug === 'temperature' ? (
              <div>
                {fromUnit.key === 'celsius' && toUnit.key === 'fahrenheit' && <div class="text-ink font-bold text-lg">°F = (°C × 9/5) + 32</div>}
                {fromUnit.key === 'fahrenheit' && toUnit.key === 'celsius' && <div class="text-ink font-bold text-lg">°C = (°F - 32) × 5/9</div>}
                {fromUnit.key === 'celsius' && toUnit.key === 'kelvin' && <div class="text-ink font-bold text-lg">K = °C + 273.15</div>}
                {fromUnit.key === 'kelvin' && toUnit.key === 'celsius' && <div class="text-ink font-bold text-lg">°C = K - 273.15</div>}
                {!['celsius-fahrenheit', 'fahrenheit-celsius', 'celsius-kelvin', 'kelvin-celsius'].includes(`${fromUnit.key}-${toUnit.key}`) && (
                  <div class="text-ink font-bold text-sm">Custom temperature scale equation applies.</div>
                )}
              </div>
            ) : (
              <div class="space-y-1">
                <div class="text-ink font-bold text-lg">
                  {toUnit.label} = {fromUnit.label} × {multiplier}
                </div>
                <div class="text-xs text-mute mt-1">
                  (1 {fromUnit.label} = {multiplier} {toUnit.label})
                </div>
              </div>
            )}
          </div>
          <p class="text-sm text-body leading-relaxed">
            {categoryDef.slug === 'temperature'
              ? `Temperature scaling involves relative differences between the freezing and boiling points of water rather than simple ratio constants.`
              : `To convert from ${fromMeta.plural} to ${toMeta.plural}, multiply the starting value by the conversion factor of ${multiplier}.`
            }
          </p>
        </div>

        <!-- Step-by-Step explanation -->
        <div class="space-y-4">
          <h2 class="text-lg font-semibold text-ink flex items-center gap-2">
            <Icon name="hugeicons:information-circle" class="w-5 h-5 text-primary" />
            How to Convert Step-by-Step
          </h2>
          <ol class="space-y-3 text-sm text-body leading-relaxed list-decimal pl-5">
            <li>Identify the starting value: <strong class="text-ink">{value} {fromUnit.symbol || fromUnit.label}</strong>.</li>
            <li>
              {categoryDef.slug === 'temperature'
                ? `Apply the absolute scaling offsets for temperature conversions.`
                : `Multiply the value by the conversion multiplier ${multiplier}.`
              }
            </li>
            <li>Obtain the calculated result: <strong class="text-ink">{resultStr} {toUnit.symbol || toUnit.label}</strong>.</li>
          </ol>
          <div class="p-3 bg-primary/5 border border-primary/10 rounded-sm font-mono text-xs text-primary">
            Math: {value} × {multiplier} = {resultStr} {toUnit.symbol || toUnit.label}
          </div>
        </div>
      </div>
    </div>

    <!-- Educational & Side Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Left Main Body -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- About conversion -->
        <section class="bg-canvas border border-hairline rounded-md p-6 sm:p-8 space-y-6">
          <h2 class="text-xl font-semibold text-ink">About this Conversion</h2>
          <p class="text-sm text-body leading-relaxed">{eduContent.intro}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-5 border-t border-hairline">
            <div class="space-y-2">
              <h3 class="font-semibold text-ink text-sm sm:text-base">{eduContent.fromSection.title}</h3>
              <p class="text-xs sm:text-sm text-body leading-relaxed">{eduContent.fromSection.text}</p>
            </div>
            <div class="space-y-2 border-t md:border-t-0 md:border-l border-hairline pt-5 md:pt-0 md:pl-6">
              <h3 class="font-semibold text-ink text-sm sm:text-base">{eduContent.toSection.title}</h3>
              <p class="text-xs sm:text-sm text-body leading-relaxed">{eduContent.toSection.text}</p>
            </div>
          </div>

          <div class="pt-5 border-t border-hairline space-y-2">
            <h3 class="font-semibold text-ink text-sm sm:text-base">Common Applications & Practical Context</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">{eduContent.useCases}</p>
          </div>
        </section>

        <!-- FAQs -->
        <section class="bg-canvas border border-hairline rounded-md p-6 sm:p-8 space-y-6">
          <h2 class="text-xl font-semibold text-ink">Frequently Asked Questions</h2>
          <div class="space-y-6 divide-y divide-hairline">
            {faqs.map((faq, index) => (
              <div class={index > 0 ? "pt-6" : ""}>
                <h4 class="text-base font-semibold text-ink mb-2">{faq.q}</h4>
                <p class="text-sm text-body leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Right Sidebar -->
      <aside class="space-y-6">
        
        <!-- Try another value -->
        <div class="bg-canvas border border-hairline rounded-md p-6 space-y-4">
          <h3 class="text-base font-semibold text-ink flex items-center gap-2 font-sans">
            <Icon name="hugeicons:search-01" class="w-4 h-4 text-primary" />
            Convert Another Value
          </h3>
          <p class="text-xs text-mute leading-relaxed font-sans">
            Enter a new value below to redirect and convert using our real-time interactive widget.
          </p>
          
          <form id="try-another-form" class="space-y-3 font-sans">
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold font-mono text-mute uppercase tracking-wider">
                Value in {fromMeta.plural}
              </label>
              <input
                id="try-another-input"
                type="number"
                step="any"
                required
                placeholder={`e.g. ${value * 10}`}
                class="w-full h-10 px-3 bg-canvas-soft border border-hairline rounded-sm text-sm font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all"
              />
            </div>
            <button
              type="submit"
              class="w-full h-10 bg-primary text-on-primary font-semibold text-sm rounded-sm hover:opacity-95 active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            >
              Convert Now
              <Icon name="hugeicons:arrow-right-01" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <!-- Related conversions -->
        <div class="bg-canvas border border-hairline rounded-md p-6 space-y-4">
          <h3 class="text-base font-semibold text-ink">{t('related_converters', locale)}</h3>
          <ul class="space-y-2.5 text-xs">
            {localizedRelatedLinks.map(link => (
              <li>
                <a href={link.href} class="text-link hover:underline flex items-center gap-1.5 font-medium">
                  <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 shrink-0" />
                  {translatePopularRoute(link.href.split('/').pop(), locale, link.label)}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Parent category backlink -->
        <div class="p-5 bg-primary/5 border border-primary/15 rounded-md">
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-2">{t('pro_tip', locale)}</h3>
          <p class="text-xs text-ink/70 leading-relaxed mb-3">
            {locale === 'es' && `¿Quiere convertir otras unidades? Visite la herramienta principal de ${localizedCategoryTitle} para ver conversiones en docenas de unidades estándar compatibles.`}
            {locale === 'hi' && `अन्य इकाइयों को बदलना चाहते हैं? दर्जनों सहायक मानक इकाइयों में रूपांतरण देखने के लिए मुख्य ${localizedCategoryTitle} उपकरण पर जाएं।`}
            {locale === 'fr' && `Vous souhaitez convertir d'autres unités ? Visitez l'outil principal de ${localizedCategoryTitle} pour voir les conversions dans des dizaines d'unités standard prises en charge.`}
            {locale === 'pt' && `Deseja converter outras unidades? Visite a ferramenta principal de ${localizedCategoryTitle} para ver conversões em dezenas de unidades padrão suportadas.`}
            {locale === 'de' && `Möchten Sie andere Einheiten umrechnen? Besuchen Sie das Hauptwerkzeug für ${localizedCategoryTitle}, um Umrechnungen in Dutzenden von Standardeinheiten anzuzeigen.`}
            {locale === 'ar' && `هل تريد تحويل وحدات أخرى؟ تفضل بزيارة أداة ${localizedCategoryTitle} الرئيسية لمشاهدة التحويلات عبر العشرات من الوحدات القياسية المدعومة.`}
            {locale === 'ja' && `他の単位を変換したいですか？メインの ${localizedCategoryTitle} ツールにアクセスして、多数の標準単位での変換を確認してください。`}
            {!['es', 'hi', 'fr', 'pt', 'de', 'ar', 'ja'].includes(locale) && `Want to convert other units? Visit the main ${localizedCategoryTitle} tool to see conversions across dozens of supporting standard units.`}
          </p>
          <a
            href={getLocalizedHref(`/unit-converters/${categoryDef.slug}`)}
            class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline"
          >
            {locale === 'es' && `Abrir ${localizedCategoryTitle}`}
            {locale === 'hi' && `${localizedCategoryTitle} खोलें`}
            {locale === 'fr' && `Ouvrir ${localizedCategoryTitle}`}
            {locale === 'pt' && `Abrir ${localizedCategoryTitle}`}
            {locale === 'de' && `${localizedCategoryTitle} öffnen`}
            {locale === 'ar' && `افتح محول ${localizedCategoryTitle}`}
            {locale === 'ja' && `${localizedCategoryTitle}を開く`}
            {!['es', 'hi', 'fr', 'pt', 'de', 'ar', 'ja'].includes(locale) && `Open ${localizedCategoryTitle}`}
            <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 font-bold" />
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script define:vars={{ categorySlug, fromUnitKey, toUnitKey, locale }}>
  const form = document.getElementById('try-another-form');
  const input = document.getElementById('try-another-input');
  const prefix = (locale || 'en') === 'en' ? '' : '/' + locale;

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (val) {
        window.location.href = `${prefix}/unit-converters/${categorySlug}?value=${encodeURIComponent(val)}&from=${encodeURIComponent(fromUnitKey)}&to=${encodeURIComponent(toUnitKey)}`;
      }
    });
  }
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type=number] { -moz-appearance: textfield; }
</style>
