---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../../components/Dropdown.astro';

const title = "Number System Converter";
const categoryTitle = "Scientific Tools";
const description = "Convert numbers between Binary, Octal, Decimal, Hexadecimal, and any base from 2 to 36 precisely.";

const allBases = [
  { key: "2", label: "Base 2 (Binary)" },
  { key: "8", label: "Base 8 (Octal)" },
  { key: "10", label: "Base 10 (Decimal)" },
  { key: "16", label: "Base 16 (Hex)" },
];
---

<Layout title={`${title} — Free Online Converter`} description={description}>
  <div class="max-w-6xl mx-auto py-6 sm:py-10 md:py-16 px-4">

    <!-- ── Breadcrumbs ──────────────────────────────────────────────────────── -->
    <nav class="flex items-center gap-1.5 sm:gap-2 mb-5 sm:mb-6 text-[10px] sm:text-[11px] font-mono text-mute uppercase tracking-widest overflow-x-auto no-scrollbar whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-body">{categoryTitle}</span>
      <Icon name="hugeicons:arrow-right-01" class="w-3 h-3 shrink-0" />
      <span class="text-ink font-semibold">{title}</span>
    </nav>

    <!-- ── Page Header ─────────────────────────────────────────────────────── -->
    <header class="mb-7 sm:mb-10">
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-ink mb-3 sm:mb-4 leading-tight">{title}</h1>
      <p class="text-body max-w-2xl leading-relaxed text-sm">{description}</p>
    </header>

    <!-- ── Converter Layout ────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-10 mb-12 sm:mb-16">
      
      <!-- Main Calculator Section -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-canvas border border-hairline rounded-md shadow-[0_1px_1px_rgba(0,0,0,0.02),0_4px_12px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10 space-y-6">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- From Base -->
              <div class="space-y-3">
                <label class="text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">From Base</label>
                <Dropdown
                  id="from-base"
                  options={allBases}
                  selected="10"
                  class="w-full"
                />
              </div>

              <!-- To Base -->
              <div class="space-y-3">
                <label class="text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">To Base</label>
                <Dropdown
                  id="to-base"
                  options={allBases}
                  selected="2"
                  class="w-full"
                />
              </div>
            </div>

            <!-- Input Number -->
            <div class="space-y-3 pt-2">
              <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Number to Convert</label>
              <input
                id="num-input"
                type="text"
                placeholder="Enter value"
                autocomplete="off"
                class="w-full h-14 sm:h-16 px-5 bg-canvas-soft border border-hairline rounded-sm text-xl sm:text-2xl font-mono font-semibold text-ink focus:outline-none focus:border-hairline-strong transition-all placeholder:text-mute/50 uppercase"
              />
              <div id="error-message" class="text-red-500 text-xs font-medium hidden">Invalid characters for selected base</div>
            </div>

            <!-- Swap Button -->
            <div class="flex justify-center -my-2 relative z-10">
               <button
                  id="swap-btn"
                  aria-label="Swap bases"
                  class="w-10 h-10 rounded-full bg-canvas border border-hairline flex items-center justify-center text-ink hover:bg-primary hover:text-on-primary hover:border-primary transition-all active:scale-90 touch-manipulation shadow-sm"
                >
                  <Icon name="hugeicons:exchange-01" class="w-4 h-4" />
                </button>
            </div>

            <!-- Result -->
            <div class="space-y-3 pt-2">
              <label class="block text-[11px] font-semibold font-mono text-mute uppercase tracking-wider">Result</label>
              <div class="relative">
                <input
                  id="num-output"
                  type="text"
                  readonly
                  placeholder="Result"
                  class="w-full h-14 sm:h-16 pl-5 pr-14 bg-canvas-soft-2 border border-hairline rounded-sm text-xl sm:text-2xl font-mono font-bold text-primary focus:outline-none transition-all cursor-default uppercase"
                />
                <button id="copy-btn" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center text-mute hover:text-ink transition-colors rounded-sm hover:bg-canvas-soft focus:outline-none" aria-label="Copy result">
                  <Icon name="hugeicons:copy-01" class="w-5 h-5" />
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="p-6 bg-canvas border border-hairline rounded-md">
          <h3 class="text-base font-semibold text-ink mb-5">Supported Bases</h3>
          <div class="space-y-4 text-sm text-body leading-relaxed">
            <p>This calculator supports conversions between any base from <strong class="text-ink">Base 2 (Binary)</strong> up to <strong class="text-ink">Base 36</strong>.</p>
            <p>For bases larger than 10, the English alphabet letters (A-Z) are used to represent digits 10 through 35.</p>
          </div>
        </div>

        <div class="p-5 bg-primary/5 border border-primary/15 rounded-md">
          <h3 class="text-xs font-semibold text-primary uppercase tracking-wider mb-2">Large Numbers Note</h3>
          <p class="text-xs text-ink/70 leading-relaxed">
            This converter uses JavaScript's native <code>BigInt</code> when possible to prevent precision loss on extremely large integers during base conversion. Decimal fractions are not currently supported by native BigInt base conversion.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const fromBaseSelect = document.getElementById('from-base') as HTMLSelectElement;
  const toBaseSelect = document.getElementById('to-base') as HTMLSelectElement;
  const inputEl = document.getElementById('num-input') as HTMLInputElement;
  const outputEl = document.getElementById('num-output') as HTMLInputElement;
  const errEl = document.getElementById('error-message');
  const swapBtn = document.getElementById('swap-btn');
  const copyBtn = document.getElementById('copy-btn');

  // Populate other bases (2-36, skipping 2,8,10,16 which are explicit)
  const explicitBases = [2, 8, 10, 16];
  const fromOptgroup = fromBaseSelect.querySelector('optgroup');
  const toOptgroup = toBaseSelect.querySelector('optgroup');

  for (let i = 2; i <= 36; i++) {
    if (explicitBases.includes(i)) continue;
    const opt1 = document.createElement('option');
    opt1.value = i.toString();
    opt1.textContent = `Base ${i}`;
    fromOptgroup?.appendChild(opt1);

    const opt2 = document.createElement('option');
    opt2.value = i.toString();
    opt2.textContent = `Base ${i}`;
    toOptgroup?.appendChild(opt2);
  }

  // Validate characters based on base
  function isValidForBase(str: string, base: number) {
    if (!str) return true; // empty is ok
    
    let regexStr = "";
    if (base <= 10) {
      regexStr = `^[0-${base - 1}]+$`;
    } else {
      const maxLetter = String.fromCharCode(87 + base); // 97 (a) - 10 + base
      regexStr = `^[0-9a-${maxLetter}]+$`;
    }
    const regex = new RegExp(regexStr, 'i');
    
    // allow optional negative sign
    let checkStr = str;
    if (checkStr.startsWith('-')) {
      checkStr = checkStr.substring(1);
    }
    
    return regex.test(checkStr);
  }

  // Conversion core
  function calculate() {
    let raw = inputEl.value.trim().toLowerCase();
    
    if (!raw) {
      errEl?.classList.add('hidden');
      outputEl.value = '';
      return;
    }

    const fromBase = parseInt(fromBaseSelect.value, 10);
    const toBase = parseInt(toBaseSelect.value, 10);

    if (!isValidForBase(raw, fromBase)) {
      errEl?.classList.remove('hidden');
      outputEl.value = 'Error';
      return;
    }
    
    errEl?.classList.add('hidden');

    try {
      // Use BigInt to avoid precision loss on huge integer strings
      // BigInt does not support decimals, so if it has a decimal point we fallback or error
      if (raw.includes('.')) {
         // Fallback to standard parseInt/toString for floats, but precision is capped
         const parsed = parseInt(raw, fromBase);
         if (isNaN(parsed)) throw new Error();
         outputEl.value = parsed.toString(toBase).toUpperCase();
      } else {
         let isNegative = raw.startsWith('-');
         if (isNegative) raw = raw.substring(1);
         
         // Parse string as BigInt in given base
         // Since BigInt constructor only takes binary (0b), octal (0o), hex (0x) or decimal natively,
         // We must write a custom BigInt parser for arbitrary bases
         let decimalBigInt = 0n;
         let baseBigInt = BigInt(fromBase);
         
         for (let i = 0; i < raw.length; i++) {
           let char = raw[i];
           let digitVal = parseInt(char, fromBase);
           decimalBigInt = (decimalBigInt * baseBigInt) + BigInt(digitVal);
         }
         
         if (decimalBigInt === 0n) {
            outputEl.value = '0';
            return;
         }

         // Convert decimal BigInt to target base
         if (toBase === 10) {
           outputEl.value = (isNegative ? '-' : '') + decimalBigInt.toString();
         } else {
           let targetBaseBigInt = BigInt(toBase);
           let resultChars = [];
           let current = decimalBigInt;
           
           while (current > 0n) {
             let rem = Number(current % targetBaseBigInt);
             if (rem < 10) {
               resultChars.push(rem.toString());
             } else {
               resultChars.push(String.fromCharCode(87 + rem));
             }
             current = current / targetBaseBigInt;
           }
           
           outputEl.value = (isNegative ? '-' : '') + resultChars.reverse().join('').toUpperCase();
         }
      }
    } catch (e) {
      outputEl.value = 'Error';
    }
  }

  // Events
  inputEl.addEventListener('input', calculate);
  fromBaseSelect.addEventListener('change', calculate);
  toBaseSelect.addEventListener('change', calculate);

  swapBtn?.addEventListener('click', () => {
    const temp = fromBaseSelect.value;
    fromBaseSelect.value = toBaseSelect.value;
    toBaseSelect.value = temp;
    
    // Swap input and output text if valid
    if (outputEl.value && outputEl.value !== 'Error') {
       inputEl.value = outputEl.value;
    }
    
    // Animate
    swapBtn.style.transform = 'rotate(180deg)';
    setTimeout(() => { swapBtn.style.transform = ''; }, 300);
    
    calculate();
  });

  copyBtn?.addEventListener('click', () => {
    const text = outputEl.value;
    if (text && text !== 'Error') {
      navigator.clipboard.writeText(text);
      const icon = copyBtn.querySelector('svg');
      if (icon) {
        const originalHTML = icon.outerHTML;
        icon.outerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
        setTimeout(() => {
          copyBtn.innerHTML = originalHTML;
        }, 1500);
      }
    }
  });

</script>
