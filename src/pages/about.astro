---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const features = [
  {
    title: "Precision First",
    description: "Our conversion engines use high-precision algorithms to ensure that every result is accurate down to the smallest decimal.",
    icon: "hugeicons:target-02"
  },
  {
    title: "Global Standards",
    description: "We support both Metric and Imperial systems, along with various specialized units used in science, engineering, and daily life.",
    icon: "hugeicons:globe"
  },
  {
    title: "Fast & Lightweight",
    description: "Designed for speed, our tools load instantly and provide results without unnecessary page refreshes or delays.",
    icon: "hugeicons:flash"
  },
  {
    title: "User Centric",
    description: "We focus on a clean, distraction-free interface that makes complex conversions feel simple and intuitive.",
    icon: "hugeicons:user-circle"
  }
];

const stats = [
  { label: "Converters", value: "500+" },
  { label: "Categories", value: "30+" },
  { label: "Monthly Users", value: "1M+" },
  { label: "Accuracy", value: "99.99%" }
];
---

<Layout>
  <div class="max-w-5xl mx-auto py-8 sm:py-12 md:py-20">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft-2 text-[11px] font-mono text-mute uppercase tracking-widest mb-6">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Our Mission
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.04em] text-ink mb-5 sm:mb-6 leading-tight">
        Simplifying units for everyone.
      </h1>
      <p class="text-lg text-body max-w-2xl mx-auto leading-relaxed">
        UnitConverter was built on a simple premise: tools should be fast, accurate, and beautiful. We've removed the clutter to give you the precision you need.
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-14 sm:mb-20">
      {stats.map(stat => (
        <div class="p-6 bg-canvas border border-hairline rounded-md text-center">
          <div class="text-3xl font-bold text-ink mb-1">{stat.value}</div>
          <div class="text-xs font-mono text-mute uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Content Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 mb-14 sm:mb-20">
      <div class="flex flex-col justify-center">
        <h2 class="text-2xl font-semibold text-ink mb-4">Why we built UnitConverter</h2>
        <div class="space-y-4 text-body leading-relaxed">
          <p>
            In a world filled with overly complex tools and ad-heavy websites, we saw a need for a professional-grade unit conversion platform that prioritizes user experience.
          </p>
          <p>
            Whether you are an engineer calculating pressure for a pipeline, a student finishing a physics assignment, or a chef converting measurements in the kitchen, accuracy is non-negotiable.
          </p>
          <p>
            Our team consists of developers and designers who believe that utility tools don't have to be boring. We've combined robust mathematical logic with a premium aesthetic to create a tool you'll actually enjoy using.
          </p>
        </div>
      </div>
      <div class="bg-canvas-soft-2 rounded-md border border-hairline p-2 flex items-center justify-center aspect-square md:aspect-auto">
        <div class="w-full h-full rounded-sm bg-canvas border border-hairline shadow-2xl overflow-hidden flex flex-col">
            <!-- Mock UI illustration -->
            <div class="h-8 border-b border-hairline flex items-center px-3 gap-1.5">
                <div class="w-2 h-2 rounded-full bg-hairline"></div>
                <div class="w-2 h-2 rounded-full bg-hairline"></div>
                <div class="w-2 h-2 rounded-full bg-hairline"></div>
            </div>
            <div class="p-6 flex flex-col gap-4">
                <div class="h-4 w-1/3 bg-canvas-soft-2 rounded-sm"></div>
                <div class="h-10 w-full bg-canvas-soft-2 rounded-sm border border-hairline"></div>
                <div class="h-10 w-full bg-primary/10 rounded-sm border border-primary/20 flex items-center justify-center">
                    <div class="h-2 w-1/4 bg-primary rounded-full"></div>
                </div>
            </div>
            <div class="mt-auto p-6 bg-canvas-soft-2 h-32 flex flex-col gap-2">
                <div class="h-2 w-1/2 bg-hairline rounded-full"></div>
                <div class="h-2 w-full bg-hairline rounded-full"></div>
                <div class="h-2 w-3/4 bg-hairline rounded-full"></div>
            </div>
        </div>
      </div>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {features.map(feature => (
        <div class="p-5 sm:p-8 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-colors group">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-sm bg-canvas-soft-2 flex items-center justify-center text-ink mb-4 sm:mb-6 group-hover:bg-primary group-hover:text-on-primary transition-colors">
            <Icon name={feature.icon} class="w-4 h-4 sm:w-5 sm:h-5" />
          </div>
          <h3 class="text-lg font-medium text-ink mb-2">{feature.title}</h3>
          <p class="text-sm text-body leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
