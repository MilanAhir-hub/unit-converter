---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Dropdown from '../components/Dropdown.astro';

const bugReportMailto = `mailto:support@realunitconverter.com?subject=${encodeURIComponent("Bug Report - Real Unit Converter")}&body=${encodeURIComponent(`Hello,

I found a bug on Real Unit Converter.

Page URL:
[Please describe where the issue occurred]

Bug Description:
[Describe the issue]

Expected Behavior:
[What should happen?]

Actual Behavior:
[What happened instead?]

Device:
[Desktop / Mobile]

Browser:
[Chrome / Safari / Firefox / Edge]

Steps to Reproduce:
1.
2.
3.

Thank you.`)}`;

const contactOptions = [
  {
    title: "General Inquiries",
    description: "Questions about our tools or how to use them? We're here to help.",
    email: "unitdevsupport@gmail.com",
    icon: "hugeicons:information-circle",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=unitdevsupport@gmail.com",
    linkText: "unitdevsupport@gmail.com"
  },
  {
    title: "Business & Partnerships",
    description: "Interested in integrating our API or partnering with us?",
    email: "unitdevsupport@gmail.com",
    icon: "hugeicons:briefcase-02",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=unitdevsupport@gmail.com",
    linkText: "unitdevsupport@gmail.com"
  },
  {
    title: "Report a Bug",
    description: "Found an error or a missing unit? Help us improve our engine.",
    email: "unitdevsupport@gmail.com",
    icon: "hugeicons:bug-01",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=unitdevsupport@gmail.com",
    linkText: "unitdevsupport@gmail.com"
  }
];
---

<Layout>
  <div class="max-w-6xl mx-auto px-4 py-8 sm:py-12 md:py-20">
    
    <!-- Centered Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft-2 text-[11px] font-mono text-mute uppercase tracking-widest mb-6">
        Contact
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.04em] text-ink mb-5 sm:mb-6 leading-tight">
        Get in touch.
      </h1>
      <p class="text-lg text-body leading-relaxed max-w-2xl mx-auto">
        We're always looking for ways to improve UnitConverter. Whether you have feedback, a feature request, or just want to say hello, we'd love to hear from you.
      </p>
    </div>

    <!-- Responsive Grid for Options -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {contactOptions.map(option => (
        <div class="flex flex-col p-6 sm:p-8 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-colors group">
          <div class="w-12 h-12 rounded-sm bg-canvas-soft-2 flex items-center justify-center text-ink mb-6 group-hover:bg-primary group-hover:text-on-primary transition-colors flex-shrink-0">
            <Icon name={option.icon} class="w-6 h-6" />
          </div>
          <div class="flex flex-col flex-grow">
            <h3 class="text-lg font-semibold text-ink mb-2">{option.title}</h3>
            <p class="text-sm text-body mb-6 leading-relaxed flex-grow">{option.description}</p>
            <a 
              href={option.href} 
              target={option.href.startsWith('http') ? "_blank" : undefined}
              rel={option.href.startsWith('http') ? "noopener noreferrer" : undefined}
              aria-label={option.title === "Report a Bug" ? "Report a bug via email with pre-filled template" : option.title === "General Inquiries" ? "Send support email via Gmail" : undefined}
              class="text-sm font-medium text-primary hover:underline inline-flex items-center gap-1.5 mt-auto self-start"
            >
              {option.linkText}
              <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</Layout>
