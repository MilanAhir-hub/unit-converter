---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="max-w-3xl mx-auto py-12">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-[-0.02em] text-ink mb-6">Blog & Guides</h1>
    <p class="text-body mb-8">Latest articles and conversion guides.</p>
    
    <div class="p-8 border border-hairline rounded-md bg-canvas text-center">
      <p class="text-mute">Posts coming soon.</p>
    </div>
  </div>
</Layout>
