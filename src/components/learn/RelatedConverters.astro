---
import { getCategoryBySlug } from '../../utils/converter';

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

// Resolve categories
const resolvedCategories = relatedSlugs.map(slug => {
  const cat = getCategoryBySlug(slug);
  if (cat) {
    return {
      slug,
      label: cat.label,
      description: cat.description || `Quickly convert between standard units of ${cat.label.toLowerCase().replace(' converter', '')}.`,
    };
  }
  
  // Generic mapping fallbacks
  const cleanLabel = slug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ') + ' Converter';
  return {
    slug,
    label: cleanLabel,
    description: `Professional, online calculations for ${cleanLabel.toLowerCase()}.`,
  };
});
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  {resolvedCategories.map((c) => (
    <a 
      href={`/unit-converters/${c.slug}`}
      class="group p-4 bg-canvas-soft border border-hairline rounded-lg flex flex-col justify-between transition-all duration-200 hover:border-hairline-strong hover:translate-y-[-2px] focus:outline-none focus:ring-2 focus:ring-primary/20"
    >
      <div>
        <div class="flex items-center gap-2.5 mb-2.5">
          <div class="w-8 h-8 rounded-md bg-canvas flex items-center justify-center text-ink border border-hairline group-hover:border-hairline-strong transition-all">
            {c.slug === 'length' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M5 3h14c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2z"/>
                <path d="M3 7h3M3 12h5M3 17h3"/>
              </svg>
            )}
            {c.slug === 'weight-mass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M12 2v20M3 7h18M6 7l-3 9h6L6 7zM18 7l-3 9h6l-3-9z"/>
              </svg>
            )}
            {c.slug === 'temperature' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0z"/>
              </svg>
            )}
            {c.slug === 'speed' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M12 2a10 10 0 0 0-10 10c0 2.2.7 4.3 2 6l1-1A8 8 0 0 1 12 4a8 8 0 0 1 7 5l1-1A10 10 0 0 0 12 2z"/>
                <path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/>
                <path d="M13.4 10.6l3.6-3.6"/>
              </svg>
            )}
            {c.slug === 'area' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M9 3v18M15 3v18M3 9h18M3 15h18"/>
              </svg>
            )}
            {c.slug === 'volume' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 7v10M12 12v10M22 7v10"/>
              </svg>
            )}
            {c.slug !== 'length' && c.slug !== 'weight-mass' && c.slug !== 'temperature' && c.slug !== 'speed' && c.slug !== 'area' && c.slug !== 'volume' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 opacity-80">
                <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                <path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            )}
          </div>
          <h4 class="text-sm font-semibold text-ink group-hover:text-primary transition-colors line-clamp-1">
            {c.label}
          </h4>
        </div>
        <p class="text-xs text-body leading-relaxed line-clamp-2">
          {c.description}
        </p>
      </div>
      
      <div class="mt-4 flex items-center gap-1 text-[11px] font-medium text-mute group-hover:text-primary transition-colors">
        <span>Go to converter</span>
        <!-- Chevron right icon inlined to guarantee compatibility -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </div>
    </a>
  ))}
</div>
