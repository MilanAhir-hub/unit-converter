---
interface Props {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { faqs } = Astro.props;
---

<div class="mt-12 sm:mt-16 space-y-8">
  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink border-b border-hairline pb-4">
    Frequently Asked Questions
  </h2>
  <div class="grid grid-cols-1 gap-6 sm:gap-8">
    {faqs.map((faq) => (
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-semibold text-ink leading-tight">
          {faq.question}
        </h3>
        <p class="text-sm sm:text-base text-body leading-relaxed">
          {faq.answer}
        </p>
      </div>
    ))}
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
})} />
