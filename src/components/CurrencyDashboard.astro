---
import { Icon } from 'astro-icon/components';
import {
  fetchHistoricalRates,
  calculateCrossRateSeries,
  calculate24hChange,
  generateSparkline
} from '../utils/currencyApi';

interface Props {
  fromUnitKey: string;
  toUnitKey: string;
}

const { fromUnitKey, toUnitKey } = Astro.props;

// Fetch all rates statically (at build time)
const historicalRates = await fetchHistoricalRates();

// Calculate series for active pair
const activeRatesSeries = calculateCrossRateSeries(historicalRates, fromUnitKey, toUnitKey);
const active24hChange = calculate24hChange(activeRatesSeries);
const activeSparkline = generateSparkline(activeRatesSeries);
const activeCurrentValue = activeRatesSeries[activeRatesSeries.length - 1];

// Define popular pairs
const popularPairsList = [
  { from: 'USD', to: 'EUR', label: 'USD / EUR' },
  { from: 'USD', to: 'INR', label: 'USD / INR' },
  { from: 'USD', to: 'GBP', label: 'USD / GBP' },
  { from: 'USD', to: 'JPY', label: 'USD / JPY' },
  { from: 'EUR', to: 'GBP', label: 'EUR / GBP' },
  { from: 'GBP', to: 'INR', label: 'GBP / INR' },
  { from: 'AUD', to: 'USD', label: 'AUD / USD' },
  { from: 'CAD', to: 'USD', label: 'CAD / USD' },
  { from: 'EUR', to: 'INR', label: 'EUR / INR' },
  { from: 'JPY', to: 'USD', label: 'JPY / USD' }
];

// Map popular pairs data
const popularPairs = popularPairsList.map(pair => {
  const ratesSeries = calculateCrossRateSeries(historicalRates, pair.from, pair.to);
  const change = calculate24hChange(ratesSeries);
  const sparkline = generateSparkline(ratesSeries);
  const value = ratesSeries[ratesSeries.length - 1];
  
  return {
    ...pair,
    value: parseFloat(value.toFixed(4)),
    change,
    sparkline
  };
});

// Format actual date timestamp from the API response
const sortedDates = Object.keys(historicalRates).sort();
const latestDate = sortedDates[sortedDates.length - 1] || new Date().toISOString().split('T')[0];
const lastUpdated = new Date(latestDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
});
---

<div class="mt-8 sm:mt-12 space-y-8">
  
  <!-- Active Pair Trend Chart -->
  <div class="bg-canvas border border-hairline rounded-md p-5 sm:p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 border-b border-hairline pb-4">
      <div>
        <h3 class="text-sm font-mono text-mute uppercase tracking-widest mb-1.5 flex items-center gap-1.5">
          <Icon name="hugeicons:chart-line-data-01" class="w-4 h-4 text-primary" />
          7-Day Trend Chart
        </h3>
        <h4 class="text-lg font-bold text-ink uppercase" id="active-pair-title-display">
          {fromUnitKey} to {toUnitKey} exchange rate
        </h4>
      </div>
      
      <div class="flex items-center gap-3">
        <div class="text-right">
          <div class="text-xs text-mute font-mono">Current Price</div>
          <div class="text-xl font-extrabold text-ink tracking-tight" id="active-pair-value-display">
            1 {fromUnitKey.toUpperCase()} = {activeCurrentValue.toFixed(4)} {toUnitKey.toUpperCase()}
          </div>
        </div>
        
        <div 
          id="active-pair-change-display"
          class={`px-2.5 py-1 rounded-full text-xs font-bold ${active24hChange.isUp ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-red-500/10 text-red-600 dark:text-red-400'}`}
        >
          {active24hChange.formatted}
        </div>
      </div>
    </div>
    
    <!-- Sparkline Graphic -->
    <div class="flex items-center justify-between gap-8 h-28 bg-canvas-soft border border-hairline rounded-sm p-4 relative overflow-hidden">
      <!-- Grid line helpers -->
      <div class="absolute inset-x-0 top-1/4 border-t border-hairline/30 pointer-events-none"></div>
      <div class="absolute inset-x-0 top-1/2 border-t border-hairline/30 pointer-events-none"></div>
      <div class="absolute inset-x-0 top-3/4 border-t border-hairline/30 pointer-events-none"></div>
      
      <div class="text-[10px] font-mono text-mute uppercase tracking-wider h-full flex flex-col justify-between select-none relative z-10">
        <div>7d High</div>
        <div>7d Low</div>
      </div>
      
      <div class="flex-grow h-full flex items-center justify-center relative z-10">
        <svg 
          id="active-sparkline-svg"
          class="w-full h-full overflow-visible" 
          viewBox="0 0 120 40" 
          preserveAspectRatio="none"
        >
          <path
            id="active-sparkline-path"
            d={activeSparkline}
            fill="none"
            stroke={active24hChange.isUp ? "#10b981" : "#ef4444"}
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      
      <div class="text-[10px] font-mono text-mute uppercase tracking-wider h-full flex flex-col justify-end select-none relative z-10">
        <div>Today</div>
      </div>
    </div>

    <!-- Freshness status -->
    <div class="flex items-center gap-1.5 mt-3.5 text-[11px] font-sans text-mute">
      <Icon name="hugeicons:clock-01" class="w-3.5 h-3.5" />
      <span>Last Updated: <strong class="text-ink font-semibold" id="last-updated-display">{lastUpdated}</strong></span>
    </div>
  </div>

  <!-- Popular Pairs Section -->
  <div class="bg-canvas border border-hairline rounded-md p-5 sm:p-6 shadow-sm">
    <h3 class="text-sm font-mono text-mute uppercase tracking-widest mb-4 flex items-center gap-1.5 border-b border-hairline pb-3">
      <Icon name="hugeicons:star" class="w-4 h-4 text-primary" />
      Popular Currency Pairs
    </h3>
    
    <div class="overflow-x-auto rounded border border-hairline -mx-4 sm:mx-0">
      <table class="w-full text-left text-xs sm:text-sm border-collapse" id="popular-pairs-table">
        <thead>
          <tr class="bg-canvas-soft-2">
            <th class="px-4 py-3 font-semibold text-ink border-b border-hairline">Currency Pair</th>
            <th class="px-4 py-3 font-semibold text-ink border-b border-hairline text-right">Exchange Rate</th>
            <th class="px-4 py-3 font-semibold text-ink border-b border-hairline text-center">7-Day Trend</th>
            <th class="px-4 py-3 font-semibold text-ink border-b border-hairline text-right">24h Change</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {popularPairs.map((pair) => (
            <tr 
              class="hover:bg-canvas-soft transition-colors cursor-pointer popular-pair-row"
              data-from={pair.from.toLowerCase()}
              data-to={pair.to.toLowerCase()}
            >
              <td class="px-4 py-3 font-semibold text-ink flex items-center gap-2">
                <Icon name="hugeicons:arrow-right-01" class="w-3.5 h-3.5 text-mute" />
                <span>{pair.label}</span>
              </td>
              <td class="px-4 py-3 text-right font-mono font-bold text-ink">
                1 {pair.from} = <span class="rate-value" data-from={pair.from} data-to={pair.to}>{pair.value}</span> {pair.to}
              </td>
              <td class="px-4 py-2 text-center flex justify-center">
                <div class="w-20 h-8 flex items-center justify-center">
                  <svg class="w-full h-full overflow-visible" viewBox="0 0 120 40" preserveAspectRatio="none">
                    <path
                      d={pair.sparkline}
                      fill="none"
                      stroke={pair.change.isUp ? "#10b981" : "#ef4444"}
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </td>
              <td class={`px-4 py-3 text-right font-bold ${pair.change.isUp ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`}>
                {pair.change.formatted}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
