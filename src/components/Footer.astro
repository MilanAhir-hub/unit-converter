---
import { Icon } from 'astro-icon/components';
import { t, translateCategory, translatePopularRoute } from '../utils/i18n';

const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale || 'en';

const getLocalizedHref = (url: string) => {
  if (locale === 'en') return url;
  if (url.startsWith('mailto:')) return url;
  if (url.startsWith('#')) return url;
  if (url.startsWith(`/${locale}`)) return url;
  return `/${locale}${url}`;
};

const popularConverters = [
  { title: "Length Converter", href: "/unit-converters/length" },
  { title: "Weight Converter", href: "/unit-converters/weight-mass" },
  { title: "Temperature Converter", href: "/unit-converters/temperature" },
  { title: "Area Converter", href: "/unit-converters/area" },
  { title: "Volume Converter", href: "/unit-converters/volume" },
  { title: "Time Converter", href: "/unit-converters/time" },
  { title: "Speed Converter", href: "/unit-converters/speed" },
  { title: "Data Storage Converter", href: "/unit-converters/data-storage" },
  { title: "Currency Converter", href: "/unit-converters/currency" },
];

const popularConversions = [
  { title: "CM to Inches", href: "/popular/cm-to-inches" },
  { title: "Inches to CM", href: "/popular/inches-to-cm" },
  { title: "KG to Pounds", href: "/popular/kg-to-pounds" },
  { title: "Pounds to KG", href: "/popular/pounds-to-kg" },
  { title: "KM to Miles", href: "/popular/km-to-miles" },
  { title: "Miles to KM", href: "/popular/miles-to-km" },
  { title: "MB to GB", href: "/popular/mb-to-gb" },
  { title: "GB to TB", href: "/popular/gb-to-tb" },
];

const calculators = [
  { title: "Percentage Calculator", href: "/calculators/percentage" },
  { title: "Age Calculator", href: "/calculators/age" },
  { title: "BMI Calculator", href: "/calculators/bmi" },
  { title: "EMI Calculator", href: "/calculators/emi" },
  { title: "Discount Calculator", href: "/calculators/discount" },
  { title: "Scientific Calculator", href: "/calculators/scientific" },
];

const bugReportMailto = `mailto:support@realunitconverter.com?subject=${encodeURIComponent("Bug Report - Real Unit Converter")}&body=${encodeURIComponent(`Hello,

I found a bug on Real Unit Converter.

Page URL:
[Please describe where the issue occurred]

Bug Description:
[Describe the issue]

Expected Behavior:
[What should happen?]

Actual Behavior:
[What happened instead?]

Device:
[Desktop / Mobile]

Browser:
[Chrome / Safari / Firefox / Edge]

Steps to Reproduce:
1.
2.
3.

Thank you.`)}`;

const footerDict: Record<string, Record<string, string>> = {
  'popular_converters': {
    'en': 'Popular Converters', 'es': 'Conversores Populares', 'hi': 'लोकप्रिय कनवर्टर', 'fr': 'Convertisseurs Populaires', 'pt': 'Conversores Populares', 'de': 'Beliebte Umrechner', 'ar': 'محولات شائعة', 'ja': '人気の変換器'
  },
  'popular_conversions': {
    'en': 'Popular Conversions', 'es': 'Conversiones Populares', 'hi': 'लोकप्रिय रूपांतरण', 'fr': 'Conversions Populaires', 'pt': 'Conversões Populares', 'de': 'Beliebte Umrechnungen', 'ar': 'تحويلات شائعة', 'ja': '人気の変換'
  },
  'calculators': {
    'en': 'Calculators', 'es': 'Calculadoras', 'hi': 'कैलकुलेटर', 'fr': 'Calculatrices', 'pt': 'Calculadoras', 'de': 'Rechner', 'ar': 'الحاسبات', 'ja': '電卓'
  },
  'resources': {
    'en': 'Resources', 'es': 'Recursos', 'hi': 'संसाधन', 'fr': 'Ressources', 'pt': 'Recursos', 'de': 'Ressourcen', 'ar': 'الموارد', 'ja': 'リソース'
  },
  'legal': {
    'en': 'Legal', 'es': 'Legal', 'hi': 'कानूनी', 'fr': 'Légal', 'pt': 'Legal', 'de': 'Rechtliches', 'ar': 'قانوني', 'ja': '法的情報'
  },
  'desc': {
    'en': "Free online unit converter with hundreds of conversion tools, calculators, and conversion pages for everyday, academic, engineering, and professional use.",
    'es': "Conversor de unidades gratuito en línea con cientos de herramientas de conversión, calculadoras y páginas de conversión para uso diario, académico, de ingeniería y profesional.",
    'hi': "मुफ़्त ऑनलाइन यूनिट कनवर्टर जिसमें दैनिक, शैक्षणिक, इंजीनियरिंग और व्यावसायिक उपयोग के लिए सैकड़ों रूपांतरण उपकरण, कैलकुलेटर और रूपांतरण पृष्ठ हैं।",
