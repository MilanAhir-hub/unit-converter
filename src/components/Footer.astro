    'de': "Kostenloser Online-Einheitenrechner mit Hunderten von Umrechnungstools, Rechnern und Umrechnungsseiten für den täglichen, akademischen, technischen und professionellen Gebrauch.",
    'ar': "محول وحدات مجاني عبر الإنترنت يحتوي على مئات من أدوات التحويل والحاسبات لجميع الاستخدامات اليومية والأكاديمية والهندسية والمهنية.",
    'ja': "日常生活、学術、エンジニアリング、専門用途向けの数百の変換ツール、電卓、変換ページを備えた無料のオンライン単位変換器。"
  },
  'blog': {
    'en': 'Blog', 'es': 'Blog', 'hi': 'ब्लॉग', 'fr': 'Blog', 'pt': 'Blog', 'de': 'Blog', 'ar': 'المدونة', 'ja': 'ブログ'
  },
  'guides': {
    'en': 'Guides', 'es': 'Guías', 'hi': 'गाइड', 'fr': 'Guides', 'pt': 'Guias', 'de': 'Leitfäden', 'ar': 'الدلائل', 'ja': 'ガイド'
  },
  'faq': {
    'en': 'FAQ', 'es': 'FAQ', 'hi': 'FAQ', 'fr': 'FAQ', 'pt': 'FAQ', 'de': 'FAQ', 'ar': 'الأسئلة الشائعة', 'ja': 'FAQ'
  },
  'about_us': {
    'en': 'About Us', 'es': 'Sobre Nosotros', 'hi': 'हमारे बारे में', 'fr': 'À Propos', 'pt': 'Sobre Nós', 'de': 'Über Uns', 'ar': 'حولنا', 'ja': '私たちについて'
  },
  'contact_us': {
    'en': 'Contact Us', 'es': 'Contacto', 'hi': 'संपर्क करें', 'fr': 'Contactez-nous', 'pt': 'Contate-nos', 'de': 'Kontaktieren Sie Uns', 'ar': 'اتصل بنا', 'ja': 'お問い合わせ'
  },
  'report_bug': {
    'en': '🐞 Report a Bug', 'es': '🐞 Reportar un Error', 'hi': '🐞 बग रिपोर्ट करें', 'fr': '🐞 Signaler un Bug', 'pt': '🐞 Relatar um Erro', 'de': '🐞 Fehler Melden', 'ar': '🐞 الإبلاغ عن خطأ', 'ja': '🐞 バグ報告'
  },
  'privacy_policy': {
    'en': 'Privacy Policy', 'es': 'Política de Privacidad', 'hi': 'गोपनीयता नीति', 'fr': 'Politique de Confidentialité', 'pt': 'Política de Privacidade', 'de': 'Datenschutzerklärung', 'ar': 'سياسة الخصوصية', 'ja': 'プライバシーポリシー'
  },
  'terms_conditions': {
    'en': 'Terms and Conditions', 'es': 'Términos y Condiciones', 'hi': 'नियम और शर्तें', 'fr': 'Conditions Générales', 'pt': 'Termos e Condições', 'de': 'Allgemeine Geschäftsbedingungen', 'ar': 'الشروط والأحكام', 'ja': '利用規約'
  },
  'disclaimer': {
    'en': 'Disclaimer', 'es': 'Descargo de Responsabilidad', 'hi': 'अस्वीकरण', 'fr': 'Avis de Non-responsabilité', 'pt': 'Isenção de Responsabilidade', 'de': 'Haftungsausschluss', 'ar': 'إخلاء المسؤولية', 'ja': '免責事項'
  },
  'cookie_policy': {
    'en': 'Cookie Policy', 'es': 'Política de Cookies', 'hi': 'कुकी नीति', 'fr': 'Politique relative aux cookies', 'pt': 'Política de Cookies', 'de': 'Cookie-Richtlinie', 'ar': 'سياسة ملفات الارتباط', 'ja': 'クッキーポリシー'
  },
  'sitemap': {
    'en': 'Sitemap', 'es': 'Mapa del Sitio', 'hi': 'साइटमैप', 'fr': 'Plan du Site', 'pt': 'Sitemap', 'de': 'Sitemap', 'ar': 'خريطة الموقع', 'ja': 'サイトマップ'
  }
};

const getFooterString = (key: string, loc: string): string => {
  return footerDict[key]?.[loc] || footerDict[key]?.['en'] || key;
};

const localizedPopularConverters = popularConverters.map(item => {
  const slug = item.href.substring('/unit-converters/'.length);
  return {
    title: translateCategory(slug, locale),
    href: getLocalizedHref(item.href)
  };
});

const localizedPopularConversions = popularConversions.map(item => {
  const slug = item.href.substring('/popular/'.length);
  return {
    title: translatePopularRoute(slug, locale, item.title),
    href: getLocalizedHref(item.href)
  };
});

const localizedCalculators = calculators.map(item => ({
  title: item.title,
  href: getLocalizedHref(item.href)
}));

const localizedResources = [
  { title: getFooterString("blog", locale), href: getLocalizedHref("/blog") },
  { title: getFooterString("guides", locale), href: getLocalizedHref("/blog") },
  { title: getFooterString("faq", locale), href: getLocalizedHref("/#faq") },
  { title: getFooterString("about_us", locale), href: getLocalizedHref("/about") },
  { title: getFooterString("contact_us", locale), href: getLocalizedHref("/contact") },
  { title: getFooterString("report_bug", locale), href: bugReportMailto },
];

const localizedLegal = [
  { title: getFooterString("privacy_policy", locale), href: getLocalizedHref("/privacy") },
  { title: getFooterString("terms_conditions", locale), href: getLocalizedHref("/terms") },
  { title: getFooterString("disclaimer", locale), href: getLocalizedHref("/disclaimer") },
  { title: getFooterString("cookie_policy", locale), href: getLocalizedHref("/cookies") },
  { title: getFooterString("sitemap", locale), href: "/sitemap-index.xml" },
];
---

<footer class="w-full bg-canvas border-t border-hairline py-10 sm:py-12 md:py-16 mt-auto">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 w-full">
    <!-- Top Footer: Brand & Multi-column Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8 pb-10 sm:pb-12 border-b border-hairline w-full text-left">
      
      <!-- Column 1: Brand -->
      <div class="flex flex-col gap-3 sm:gap-4 col-span-2 sm:col-span-2 md:col-span-3 lg:col-span-1">
        <a href={getLocalizedHref("/")} class="flex items-center gap-2 select-none">
          <img src="/lightmode_unit.png" alt="UnitConverter" class="h-7 sm:h-8 w-auto dark:hidden" />
          <img src="/darkmode_unit.png" alt="UnitConverter" class="h-7 sm:h-8 w-auto hidden dark:block" />
        </a>
        <p class="text-[13px] text-body leading-relaxed max-w-xs sm:max-w-sm">
          {getFooterString("desc", locale)}
        </p>
      </div>

      <!-- Column 2: Popular Converters -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <h4 class="text-[11px] font-semibold tracking-wider font-mono text-mute uppercase select-none">
          {getFooterString("popular_converters", locale)}
        </h4>
        <ul class="flex flex-col gap-2">
          {localizedPopularConverters.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-body hover:text-ink hover:underline transition-colors block py-3 sm:py-0.5 truncate max-w-full touch-manipulation">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Popular Conversions -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <h4 class="text-[11px] font-semibold tracking-wider font-mono text-mute uppercase select-none">
          {getFooterString("popular_conversions", locale)}
        </h4>
        <ul class="flex flex-col gap-2">
          {localizedPopularConversions.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-body hover:text-ink hover:underline transition-colors block py-3 sm:py-0.5 truncate max-w-full touch-manipulation">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Calculators -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <h4 class="text-[11px] font-semibold tracking-wider font-mono text-mute uppercase select-none">
          {getFooterString("calculators", locale)}
        </h4>
        <ul class="flex flex-col gap-2">
          {localizedCalculators.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-body hover:text-ink hover:underline transition-colors block py-3 sm:py-0.5 truncate max-w-full touch-manipulation">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 5: Resources -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <h4 class="text-[11px] font-semibold tracking-wider font-mono text-mute uppercase select-none">
          {getFooterString("resources", locale)}
        </h4>
        <ul class="flex flex-col gap-2">
          {localizedResources.map((item) => (
            <li>
              <a 
                href={item.href} 
                aria-label={item.href.startsWith('mailto:') ? "Report a bug via email with pre-filled template" : undefined}
                class="text-[13px] text-body hover:text-ink hover:underline transition-colors block py-3 sm:py-0.5 truncate max-w-full touch-manipulation"
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 6: Legal -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <h4 class="text-[11px] font-semibold tracking-wider font-mono text-mute uppercase select-none">
          {getFooterString("legal", locale)}
        </h4>
        <ul class="flex flex-col gap-2">
          {localizedLegal.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] text-body hover:text-ink hover:underline transition-colors block py-3 sm:py-0.5 truncate max-w-full touch-manipulation">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom Footer: Copyright & Additional Links -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 pt-6 sm:pt-8 text-[12px] text-mute select-none font-mono w-full">
      <div>
        &copy; {currentYear} UnitConverter. {t('footer_rights', locale)}
      </div>
      <div class="flex items-center gap-3 sm:gap-4 flex-wrap justify-center">
        <a href={getLocalizedHref("/sitemap")} class="hover:text-ink transition-colors py-3.5 sm:py-1 inline-flex items-center">{getFooterString("sitemap", locale)}</a>
        <span aria-hidden="true">&bull;</span>
        <a href={getLocalizedHref("/privacy")} class="hover:text-ink transition-colors py-3.5 sm:py-1 inline-flex items-center">{getFooterString("privacy_policy", locale)}</a>
        <span aria-hidden="true">&bull;</span>
        <a href={getLocalizedHref("/terms")} class="hover:text-ink transition-colors py-3.5 sm:py-1 inline-flex items-center">{getFooterString("terms_conditions", locale)}</a>
      </div>
    </div>
  </div>
</footer>
