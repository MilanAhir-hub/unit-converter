---
import { t } from '../utils/i18n';

interface Props {
  className?: string;
}

const { className } = Astro.props;
const locale = Astro.currentLocale || 'en';

const getLocalizedFaqList = (loc: string) => {
  const templates: Record<string, Array<{ question: string; answer: string }>> = {
    'en': [
      {
        question: "What is a unit converter?",
        answer: "A unit converter is a digital tool designed to translate a value from one measurement unit to another without changing the quantity's actual magnitude. Whether you are converting meters to feet, kilograms to pounds, or Celsius to Fahrenheit, these tools ensure accuracy across different measurement systems."
      },
      {
        question: "What happened to Google Unit Converter?",
        answer: "The Google Unit Converter is still fully functional and built directly into Google Search. Just type your conversion request (e.g., \"5 kg to lbs\") into the search bar, and an interactive converter widget will appear instantly."
      },
      {
        question: "How to make a unit converter in Python?",
        answer: "Building a unit converter in Python is simple. Store conversion factors in a dictionary. Convert the input value to a base unit, then divide by the target unit's factor. Libraries like Tkinter can add a GUI."
      },
      {
