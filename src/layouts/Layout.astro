---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import ScientificBackground from '../components/background/ScientificBackground.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Unit Converter — Free Online Conversion Tools',
  description = 'Free online unit converter with hundreds of conversion tools, calculators, and conversion pages for everyday, academic, engineering, and professional use.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-8D85PRT51S" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-8D85PRT51S');
		</script>

		<!-- Google AdSense -->
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1158005578303314" crossorigin="anonymous" is:inline></script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/darkmode_unit.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script is:inline>
			// Check user theme preference, fallback to dark mode as default
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			})();
			
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-canvas-soft text-ink font-sans antialiased min-h-screen overflow-x-hidden">
		<ScientificBackground />
		<Navbar />
		<Sidebar />
		
		<div class="pt-[64px] min-h-screen flex flex-col relative z-[1]">
			<main class="px-4 md:px-8 py-6 md:py-10 max-w-[1400px] mx-auto w-full flex-grow">
				<slot />
			</main>
			<Footer />
		</div>
		<ScrollToTop />
	</body>
</html>
